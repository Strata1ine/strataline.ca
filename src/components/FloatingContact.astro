---
import { Icon } from 'astro-icon/components';
import ConsultationCTA from '@/components/prototype/ConsultationCTA.astro';
import '@/styles/interior-renovations-prototype.css';

interface Props {
	defaultProjectType?: string;
	projectHelperText?: string;
	eventPrefix?: string;
	openEventName?: string;
	formStartEventName?: string;
	formSubmitEventName?: string;
}

const {
	defaultProjectType,
	projectHelperText,
	eventPrefix,
	openEventName,
	formStartEventName,
	formSubmitEventName,
} = Astro.props;
---

<div
	class="floating-contact"
	data-floating-contact
	data-event-prefix={eventPrefix}
	data-open-event-name={openEventName}
>
	<button
		class="floating-contact__trigger"
		type="button"
		aria-label="Contact Strataline"
		aria-haspopup="dialog"
		aria-controls="floating-contact-dialog"
		data-floating-contact-open
	>
		<Icon name="ph:chat-circle-dots" class="size-7" aria-hidden="true" is:inline />
	</button>

	<dialog
		class="floating-contact__dialog"
		id="floating-contact-dialog"
		aria-labelledby="consultation-popup-title"
		data-floating-contact-dialog
	>
		<div class="floating-contact__panel">
			<button
				class="floating-contact__close"
				type="button"
				aria-label="Close contact form"
				data-floating-contact-close
			>
				<Icon name="ph:x" class="size-6" aria-hidden="true" is:inline />
			</button>
			<ConsultationCTA
				formId="consultation-popup"
				mode="popup"
				reveal={false}
				{defaultProjectType}
				{projectHelperText}
				{eventPrefix}
				startEventName={formStartEventName}
				submitEventName={formSubmitEventName}
			/>
		</div>
	</dialog>
</div>

<script is:inline>
	if (!window.trackContactEvent) {
		window.trackContactEvent = (name, params = {}) => {
			const protoTracker = Reflect.get(window, 'trackProtoEvent');
			if (typeof protoTracker === 'function') {
				protoTracker(name, params);
			} else if (typeof window.gtag === 'function') {
				window.gtag('event', name, params);
			}
			window.dispatchEvent(
				new CustomEvent('strataline:contact-event', { detail: { name, params } }),
			);
		};
	}

	document.querySelectorAll('[data-floating-contact]').forEach((root) => {
		if (!(root instanceof HTMLElement) || root.dataset.initialized) return;
		root.dataset.initialized = 'true';

		const trigger = root.querySelector('[data-floating-contact-open]');
		const dialog = root.querySelector('[data-floating-contact-dialog]');
		const closeButton = root.querySelector('[data-floating-contact-close]');
		const eventPrefix = root.dataset.eventPrefix;
		const openEventName = root.dataset.openEventName;
		if (!(trigger instanceof HTMLButtonElement) || !(dialog instanceof HTMLDialogElement)) return;
		let scrollPosition = 0;
		const mobileViewport = window.matchMedia('(max-width: 767px)');
		const keepFocusedControlVisible = () => {
			if (!dialog.open || !mobileViewport.matches) return;
			const activeElement = document.activeElement;
			if (
				!(activeElement instanceof HTMLElement) ||
				!dialog.contains(activeElement) ||
				!activeElement.matches('input, select, textarea, button, [data-form-heading]')
			)
				return;

			requestAnimationFrame(() => {
				const viewport = window.visualViewport;
				const viewportTop = (viewport?.offsetTop ?? 0) + 8;
				const viewportBottom = viewportTop + (viewport?.height ?? window.innerHeight) - 8;
				const controlRect = activeElement.getBoundingClientRect();
				if (controlRect.top < viewportTop || controlRect.bottom > viewportBottom) {
					activeElement.scrollIntoView({ block: 'nearest', inline: 'nearest' });
				}
			});
		};

		const closeDialog = () => dialog.close();
		const openDialog = () => {
			scrollPosition = window.scrollY;
			window.trackContactEvent?.(
				openEventName ??
					(eventPrefix ? `${eventPrefix}_form_open_popup` : 'contact_form_open_popup'),
			);
			document.documentElement.style.setProperty(
				'--floating-contact-scroll-offset',
				`${-scrollPosition}px`,
			);
			document.documentElement.classList.add('floating-contact-open');
			dialog.showModal();
			document.dispatchEvent(new CustomEvent('strataline:initialize-contact-forms'));
			requestAnimationFrame(() => {
				const firstField = dialog.querySelector(
					'[data-form-step="1"] select, [data-form-step="1"] input',
				);
				if (firstField instanceof HTMLElement) firstField.focus();
			});
		};

		trigger.addEventListener('click', openDialog);
		document.addEventListener('strataline:open-contact', openDialog);
		closeButton?.addEventListener('click', closeDialog);
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) closeDialog();
		});
		dialog.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			event.preventDefault();
			closeDialog();
		});
		dialog.addEventListener('close', () => {
			document.documentElement.classList.remove('floating-contact-open');
			document.documentElement.style.removeProperty('--floating-contact-scroll-offset');
			window.scrollTo({ top: scrollPosition, behavior: 'instant' });
			trigger.focus();
		});
		dialog.addEventListener('focusin', keepFocusedControlVisible);
		window.addEventListener('resize', keepFocusedControlVisible, { passive: true });
		window.visualViewport?.addEventListener('resize', keepFocusedControlVisible, {
			passive: true,
		});
		window.visualViewport?.addEventListener('scroll', keepFocusedControlVisible, {
			passive: true,
		});

		const inlineActions = [
			...document.querySelectorAll(
				'[data-contact-mode="inline"], [data-contact-mode="inline"] [data-form-next], [data-contact-mode="inline"] [data-form-submit], [data-floating-contact-avoid]',
			),
		];
		if (inlineActions.length) {
			const updateInlineActionOverlap = () => {
				const bubbleRect = trigger.getBoundingClientRect();
				const overlapsInlineAction = inlineActions.some((action) => {
					const actionRect = action.getBoundingClientRect();
					return (
						actionRect.width > 0 &&
						actionRect.height > 0 &&
						bubbleRect.left < actionRect.right &&
						bubbleRect.right > actionRect.left &&
						bubbleRect.top < actionRect.bottom &&
						bubbleRect.bottom > actionRect.top
					);
				});
				root.classList.toggle('is-inline-visible', overlapsInlineAction);
				trigger.inert = overlapsInlineAction;
				trigger.hidden = overlapsInlineAction;
			};
			window.addEventListener('scroll', updateInlineActionOverlap, { passive: true });
			window.addEventListener('resize', updateInlineActionOverlap);
			requestAnimationFrame(updateInlineActionOverlap);
		}
	});
</script>

<style is:global>
	.floating-contact {
		position: fixed;
		right: max(28px, env(safe-area-inset-right));
		bottom: max(28px, env(safe-area-inset-bottom));
		z-index: 50;
	}

	.floating-contact:has(dialog[open]) {
		z-index: 100;
	}

	.floating-contact__trigger {
		display: grid;
		width: 64px;
		height: 64px;
		place-items: center;
		border: 1px solid rgba(23, 23, 23, 0.7);
		border-radius: 999px;
		background: #fbfaf7;
		color: #171717;
		box-shadow: 0 10px 30px rgba(20, 20, 20, 0.16);
		cursor: pointer;
		transition:
			transform 160ms ease,
			box-shadow 160ms ease;
	}

	.floating-contact__trigger:hover {
		transform: translateY(-2px);
		box-shadow: 0 14px 34px rgba(20, 20, 20, 0.2);
	}

	.floating-contact.is-inline-visible .floating-contact__trigger {
		opacity: 0;
		pointer-events: none;
	}

	.floating-contact__trigger:focus-visible,
	.floating-contact__close:focus-visible {
		outline: 2px solid #986536;
		outline-offset: 4px;
	}

	.floating-contact__dialog {
		width: min(720px, calc(100% - 2rem));
		max-width: none;
		max-height: min(90svh, 920px);
		margin: auto;
		padding: 0;
		border: 0;
		border-radius: 22px;
		background: transparent;
		box-shadow: 0 28px 90px rgba(0, 0, 0, 0.28);
		overflow: hidden;
	}

	.floating-contact__dialog::backdrop {
		background: rgba(17, 20, 18, 0.58);
		backdrop-filter: blur(5px);
	}

	.floating-contact__panel {
		position: relative;
		max-height: min(90svh, 920px);
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.floating-contact__panel .proto-consultation {
		width: 100%;
		margin: 0;
		border-radius: 22px;
	}

	.floating-contact__panel .proto-consultation__form {
		min-height: 0;
		padding: 2.25rem 2.5rem;
	}

	.floating-contact__close {
		position: sticky;
		top: 0.8rem;
		z-index: 3;
		display: grid;
		width: 44px;
		height: 44px;
		margin: 0 0.8rem -44px auto;
		place-items: center;
		border: 1px solid rgba(255, 255, 255, 0.24);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
		backdrop-filter: blur(10px);
		cursor: pointer;
	}

	@media (min-width: 768px) and (max-height: 850px) {
		.floating-contact__panel .proto-consultation__form {
			padding: 1.5rem 2rem;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-step {
			gap: 0.55rem;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-consultation__fields {
			gap: 0.55rem 0.85rem;
		}
	}

	html.floating-contact-open {
		overflow: hidden;
	}

	@media (max-width: 767px) {
		html.floating-contact-open,
		html.floating-contact-open body {
			overflow: hidden;
			overscroll-behavior: none;
		}

		html.floating-contact-open body {
			position: fixed;
			top: var(--floating-contact-scroll-offset, 0);
			right: 0;
			left: 0;
			width: 100%;
		}

		.floating-contact {
			right: max(18px, env(safe-area-inset-right));
			bottom: max(20px, env(safe-area-inset-bottom));
		}

		body:has(.proto-mobile-contact) .floating-contact {
			bottom: calc(5rem + env(safe-area-inset-bottom));
		}

		.floating-contact__trigger {
			width: 58px;
			height: 58px;
		}

		.floating-contact__dialog {
			position: fixed;
			inset: 0;
			box-sizing: border-box;
			width: 100%;
			height: 100svh;
			max-height: 100svh;
			height: 100dvh;
			max-height: 100dvh;
			margin: 0;
			padding: max(8px, env(safe-area-inset-top)) max(8px, env(safe-area-inset-right))
				max(8px, env(safe-area-inset-bottom)) max(8px, env(safe-area-inset-left));
			border-radius: 0;
			box-shadow: none;
		}

		.floating-contact__panel {
			width: 100%;
			height: 100%;
			max-height: 100%;
			border-radius: 18px;
			overflow-y: auto;
			overscroll-behavior: contain;
		}

		.floating-contact__panel .proto-consultation {
			min-height: 100%;
			border-radius: 18px;
		}

		.floating-contact__panel .proto-consultation__form {
			box-sizing: border-box;
			min-height: 100%;
			padding: 0.75rem;
		}

		.floating-contact__close {
			top: 0.5rem;
			margin: 0 0.5rem -44px auto;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-consultation__intro {
			margin-bottom: 0.5rem;
			padding-right: 3.25rem;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-consultation__intro .proto-eyebrow {
			margin-bottom: 0.2rem;
			font-size: 0.7rem;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-consultation__intro h2 {
			font-size: clamp(1.65rem, 7.4vw, 2rem);
			line-height: 1;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-consultation__intro > p:last-child {
			margin-top: 0.3rem;
			font-size: 0.8rem;
			line-height: 1.3;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-step {
			gap: 0.5rem;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-progress {
			gap: 0.3rem;
		}

		.floating-contact__panel [data-contact-mode='popup'] [data-form-step='2'] .proto-form-progress {
			padding-right: 3.25rem;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-step__label {
			font-size: 0.78rem;
			line-height: 1.2;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-step__intro {
			margin: 0;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-step__intro h4 {
			font-size: 1.45rem;
			line-height: 1;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-consultation__fields {
			gap: 0.5rem;
		}

		.floating-contact__panel [data-contact-mode='popup'] label {
			gap: 0.2rem;
		}

		.floating-contact__panel [data-contact-mode='popup'] label > span {
			font-size: 0.75rem;
			line-height: 1.15;
			letter-spacing: 0.06em;
		}

		.floating-contact__panel [data-contact-mode='popup'] input,
		.floating-contact__panel [data-contact-mode='popup'] select,
		.floating-contact__panel [data-contact-mode='popup'] textarea {
			min-height: 44px;
			padding: 0.55rem 0.7rem;
			font-size: 1rem;
			line-height: 1.2;
		}

		.floating-contact__panel [data-contact-mode='popup'] textarea {
			height: 58px;
			resize: none;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-next {
			gap: 0.35rem;
			margin-top: 0;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-next__contact {
			gap: 0.15rem;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-reassurance {
			font-size: 0.78rem;
			line-height: 1.25;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-contact-alternative {
			min-height: 0;
			justify-content: flex-start;
			gap: 0.15rem 0.35rem;
			font-size: 0.75rem;
			line-height: 1.25;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-contact-alternative a {
			display: inline-flex;
			min-height: 44px;
			align-items: center;
			font-size: 0.9rem;
			line-height: 1.25;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-next .proto-button,
		.floating-contact__panel
			[data-contact-mode='popup']
			.proto-form-submit-actions
			.proto-button--primary,
		.floating-contact__panel [data-contact-mode='popup'] .proto-form-back {
			min-height: 44px;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-submit-actions {
			gap: 0.25rem;
			margin-top: 0;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-back {
			display: inline-flex;
			align-items: center;
			padding: 0 0.25rem;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-consultation__privacy {
			font-size: 0.72rem;
			line-height: 1.3;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-field-helper {
			margin-top: 0;
			font-size: 0.72rem;
			line-height: 1.25;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-field-helper a {
			display: inline-flex;
			min-height: 44px;
			align-items: center;
			font-size: 0.86rem;
			vertical-align: middle;
		}
	}

	@media (max-width: 600px) and (max-height: 720px) {
		.floating-contact__panel,
		.floating-contact__panel .proto-consultation {
			border-radius: 12px;
		}

		.floating-contact__panel .proto-consultation__form {
			padding: 0.375rem 0.625rem;
		}

		.floating-contact__close {
			top: 0.35rem;
			margin-right: 0.35rem;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-consultation__intro {
			margin-bottom: 0.3rem;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-consultation__intro h2 {
			font-size: 1.45rem;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-consultation__intro > p:last-child {
			margin-top: 0.2rem;
			font-size: 0.74rem;
			line-height: 1.2;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-step {
			gap: 0.35rem;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-consultation__fields {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.35rem 0.5rem;
		}

		.floating-contact__panel
			[data-contact-mode='popup']
			.proto-consultation__fields
			> label:has(.proto-form-field-helper) {
			grid-column: 1 / -1;
		}

		.floating-contact__panel
			[data-contact-mode='popup']
			[data-form-step='1']:has(.proto-form-field-helper)
			.proto-consultation__field-wide {
			grid-column: auto;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-step__intro h4 {
			font-size: 1.3rem;
		}

		.floating-contact__panel [data-contact-mode='popup'] textarea {
			height: 52px;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-next {
			gap: 0.25rem;
		}

		.floating-contact__panel [data-contact-mode='popup'] .proto-form-submit-actions {
			gap: 0.15rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.floating-contact__trigger {
			transition: none;
		}
	}
</style>
