---
import { Image } from 'astro:assets';
import { recentWork } from '@/data/interiorRenovationsPrototype';

type WorkItem = (typeof recentWork)[number] & { projectHref?: string };

interface Props {
	items?: WorkItem[];
	id?: string;
	eyebrow?: string;
	title?: string;
	description?: string;
	eventName?: string;
	serviceClickEventName?: string;
}

const {
	items = recentWork,
	id = 'recent-work',
	eyebrow = 'Recent work',
	title = 'Finished interiors, built as one complete space',
	description = 'Real Strataline projects across kitchens, bathrooms, living areas, ceilings, flooring and staircases.',
	eventName = 'project_open',
	serviceClickEventName,
} = Astro.props;
---

<section
	class="proto-recent-work section-anchor"
	id={id}
	data-work-section
	data-project-event-name={eventName}
	data-service-click-event-name={serviceClickEventName}
>
	<div class="proto-section-head reveal">
		<p class="proto-eyebrow">{eyebrow}</p>
		<h2>{title}</h2>
		<p>{description}</p>
	</div>
	<div class="proto-work-gallery" data-work-gallery>
		{
			items.map((item, index) => (
				<article
					class:list={[
						'proto-work-gallery__item reveal',
						index === 0 && 'proto-work-gallery__item--featured',
						item.projectHref && 'has-project-story',
					]}
				>
					<button
						type="button"
						style={`--work-object-position: ${item.objectPosition};`}
						data-lightbox-open
						data-index={index}
						data-full={item.image.src.src}
						data-alt={item.image.alt}
						data-caption={item.caption}
						data-service={item.service}
						data-location={item.location}
						data-summary={item.summary}
					>
						<figure>
							<Image
								src={item.image.src}
								alt={item.image.alt}
								widths={[480, 720, 960, 1280]}
								sizes={
									index === 0 ? '(max-width: 900px) 100vw, 55vw' : '(max-width: 900px) 50vw, 22vw'
								}
								loading="lazy"
							/>
						</figure>
						<span>{item.caption}</span>
					</button>
					{item.projectHref && (
						<a class="proto-work-gallery__story" href={item.projectHref}>
							View project story
						</a>
					)}
					<a class="proto-work-gallery__service" href={item.href}>
						Explore service
					</a>
				</article>
			))
		}
	</div>
	<div class="proto-work-gallery__library">
		<p>These are genuine Strataline renovations documented across the growing project library.</p>
		<a href="/blog">Explore Projects &amp; Guides <span aria-hidden="true">→</span></a>
	</div>

	<div
		class="proto-lightbox"
		role="dialog"
		aria-modal="true"
		aria-label="Recent work image viewer"
		data-lightbox
		hidden
	>
		<div class="proto-lightbox__shell">
			<button class="proto-lightbox__close" type="button" data-lightbox-close>
				<span aria-hidden="true">×</span>
				<span class="sr-only">Close image viewer</span>
			</button>
			<button
				class="proto-lightbox__nav proto-lightbox__nav--prev"
				type="button"
				data-lightbox-prev
			>
				<span aria-hidden="true">‹</span>
				<span class="sr-only">Previous image</span>
			</button>
			<figure class="proto-lightbox__figure">
				<div class="proto-lightbox__media" data-lightbox-media>
					<img
						src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
						alt=""
						data-lightbox-image
					/>
				</div>
				<figcaption>
					<strong data-lightbox-caption></strong>
					<span data-lightbox-meta></span>
					<span data-lightbox-summary></span>
				</figcaption>
			</figure>
			<button
				class="proto-lightbox__nav proto-lightbox__nav--next"
				type="button"
				data-lightbox-next
			>
				<span aria-hidden="true">›</span>
				<span class="sr-only">Next image</span>
			</button>
		</div>
	</div>
</section>

<script is:inline>
	const workSection = document.querySelector('[data-work-section]');
	const galleryButtons = [...(workSection?.querySelectorAll('[data-lightbox-open]') ?? [])];
	const lightbox = workSection?.querySelector('[data-lightbox]');
	const lightboxMedia = workSection?.querySelector('[data-lightbox-media]');
	const lightboxImage = workSection?.querySelector('[data-lightbox-image]');
	const lightboxCaption = workSection?.querySelector('[data-lightbox-caption]');
	const lightboxMeta = workSection?.querySelector('[data-lightbox-meta]');
	const lightboxSummary = workSection?.querySelector('[data-lightbox-summary]');
	const closeButton = workSection?.querySelector('[data-lightbox-close]');
	const previousButton = workSection?.querySelector('[data-lightbox-prev]');
	const nextButton = workSection?.querySelector('[data-lightbox-next]');
	let activeIndex = 0;
	let lastFocused = null;
	let startX = 0;

	const focusableSelector =
		'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';

	const syncImageOrientation = () => {
		if (!(lightboxMedia instanceof HTMLElement) || !(lightboxImage instanceof HTMLImageElement))
			return;
		lightboxMedia.classList.toggle(
			'is-portrait',
			lightboxImage.naturalHeight > lightboxImage.naturalWidth,
		);
		lightboxMedia.scrollTop = 0;
	};

	lightboxImage?.addEventListener('load', syncImageOrientation);

	const showImage = (index) => {
		const button = galleryButtons[index];
		if (!(button instanceof HTMLElement)) return;
		activeIndex = index;
		lightboxMedia?.classList.remove('is-portrait');
		if (lightboxImage instanceof HTMLImageElement) {
			lightboxImage.src = button.dataset.full ?? '';
			lightboxImage.alt = button.dataset.alt ?? '';
		}
		if (lightboxCaption) lightboxCaption.textContent = button.dataset.caption ?? '';
		if (lightboxMeta) {
			lightboxMeta.textContent = [button.dataset.service, button.dataset.location]
				.filter(Boolean)
				.join(' • ');
		}
		if (lightboxSummary) lightboxSummary.textContent = button.dataset.summary ?? '';
	};

	const openLightbox = (index) => {
		if (!(lightbox instanceof HTMLElement)) return;
		lastFocused = document.activeElement;
		showImage(index);
		lightbox.hidden = false;
		document.documentElement.classList.add('proto-no-scroll');
		Reflect.get(
			window,
			'trackProtoEvent',
		)?.(workSection?.dataset.projectEventName ?? 'project_open');
		closeButton?.focus();
	};

	const closeLightbox = () => {
		if (!(lightbox instanceof HTMLElement)) return;
		lightbox.hidden = true;
		document.documentElement.classList.remove('proto-no-scroll');
		lightboxMedia?.classList.remove('is-portrait');
		if (lastFocused instanceof HTMLElement) lastFocused.focus();
	};

	const stepLightbox = (direction) => {
		const nextIndex = (activeIndex + direction + galleryButtons.length) % galleryButtons.length;
		showImage(nextIndex);
	};

	galleryButtons.forEach((button, index) => {
		button.addEventListener('click', () => openLightbox(index));
	});
	workSection?.querySelectorAll('.proto-work-gallery__service').forEach((link) => {
		link.addEventListener('click', () => {
			const eventName = workSection.dataset.serviceClickEventName;
			if (eventName) Reflect.get(window, 'trackProtoEvent')?.(eventName);
		});
	});

	closeButton?.addEventListener('click', closeLightbox);
	previousButton?.addEventListener('click', () => stepLightbox(-1));
	nextButton?.addEventListener('click', () => stepLightbox(1));

	lightbox?.addEventListener('touchstart', (event) => {
		startX = event.changedTouches[0]?.clientX ?? 0;
	});

	lightbox?.addEventListener('touchend', (event) => {
		const endX = event.changedTouches[0]?.clientX ?? 0;
		if (Math.abs(endX - startX) < 48) return;
		stepLightbox(endX < startX ? 1 : -1);
	});

	document.addEventListener('keydown', (event) => {
		if (!(lightbox instanceof HTMLElement) || lightbox.hidden) return;
		if (event.key === 'Escape') closeLightbox();
		if (event.key === 'ArrowLeft') stepLightbox(-1);
		if (event.key === 'ArrowRight') stepLightbox(1);
		if (event.key !== 'Tab') return;

		const focusable = [...lightbox.querySelectorAll(focusableSelector)].filter(
			(element) => element instanceof HTMLElement && !element.hasAttribute('disabled'),
		);
		const first = focusable[0];
		const last = focusable[focusable.length - 1];
		if (!(first instanceof HTMLElement) || !(last instanceof HTMLElement)) return;

		if (event.shiftKey && document.activeElement === first) {
			event.preventDefault();
			last.focus();
		} else if (!event.shiftKey && document.activeElement === last) {
			event.preventDefault();
			first.focus();
		}
	});
</script>
<style>
	.proto-work-gallery .proto-work-gallery__story {
		position: absolute;
		bottom: 2.45rem;
		left: 0;
		z-index: 3;
		padding: 0.65rem 1rem;
		color: #fff;
		font-size: 0.78rem;
		font-weight: 750;
		text-underline-offset: 0.25em;
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
	}
	.proto-work-gallery__item.has-project-story button > span {
		bottom: 5rem;
	}
	.proto-work-gallery__library {
		display: flex;
		width: min(var(--proto-wide), 100%);
		justify-content: space-between;
		gap: 1.5rem;
		align-items: center;
		margin: 1.5rem auto 0;
		padding-top: 1.25rem;
		border-top: 1px solid var(--proto-border);
	}
	.proto-work-gallery__library p {
		max-width: 46rem;
		margin: 0;
		color: var(--proto-muted);
	}
	.proto-work-gallery__library a {
		color: inherit;
		font-weight: 750;
		white-space: nowrap;
	}
	@media (max-width: 700px) {
		.proto-work-gallery__library {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}
	}
</style>
