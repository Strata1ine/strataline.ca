---
import { navItems, primaryServices, servicesMenu } from '@/data/interiorRenovationsPrototype';
---

<header class="proto-header" data-prototype-header>
	<a class="proto-wordmark" href="/" aria-label="Strataline home">
		<span class="proto-wordmark__mark">S</span>
		<span>Strataline</span>
	</a>

	<nav class="proto-nav" aria-label="Global navigation">
		{
			navItems.map((item) =>
				item.hasMenu ? (
					<div class="proto-nav__item proto-nav__item--menu" data-services-menu-item>
						<button
							class="proto-nav__button"
							type="button"
							aria-expanded="false"
							aria-haspopup="true"
							aria-controls="services-mega-panel"
							data-services-menu-button
						>
							{item.label}
						</button>
					</div>
				) : (
					<a href={item.href}>{item.label}</a>
				),
			)
		}
	</nav>

	<a class="proto-header__cta" href="#consultation">Request a Quote</a>

	<button
		class="proto-menu-button"
		type="button"
		aria-controls="prototype-mobile-menu"
		aria-expanded="false"
		data-menu-toggle
	>
		<span class="sr-only" data-menu-label>Open menu</span>
		<span></span>
		<span></span>
	</button>
</header>

<div class="proto-mega-backdrop" data-services-backdrop aria-hidden="true"></div>

<section
	id="services-mega-panel"
	class="proto-mega-panel"
	aria-label="Services menu"
	aria-hidden="true"
	data-services-menu-panel
>
	<div class="proto-mega-panel__inner">
		<div class="proto-mega-panel__primary">
			<p>Primary services</p>
			<nav aria-label="Primary services">
				{
					primaryServices.map((link) => (
						<a
							href={link.href}
							aria-current={link.href === '/interior-renovations' ? 'page' : undefined}
						>
							{link.label}
						</a>
					))
				}
			</nav>
		</div>

		{
			servicesMenu.map((group) => (
				<div class="proto-mega-panel__group">
					<p>{group.title}</p>
					<nav aria-label={group.title}>
						{group.links.map((link) => (
							<a href={link.href}>{link.label}</a>
						))}
					</nav>
				</div>
			))
		}

		<div class="proto-mega-panel__footer">
			<p>Not sure where your project fits?</p>
			<div>
				<a class="proto-button proto-button--primary" href="#consultation">Request a Quote</a>
				<a class="proto-mega-panel__phone" href="tel:+14164715999">
					Call or Text <strong>(416) 471-5999</strong>
				</a>
			</div>
		</div>
	</div>
</section>

<div
	class="proto-mobile-menu"
	id="prototype-mobile-menu"
	data-mobile-menu
	role="dialog"
	aria-modal="true"
	aria-label="Site navigation"
	hidden
>
	<nav aria-label="Mobile navigation">
		<details open>
			<summary>Primary services</summary>
			<div class="proto-mobile-menu__group">
				{
					primaryServices.map((link) => (
						<a
							href={link.href}
							aria-current={link.href === '/interior-renovations' ? 'page' : undefined}
						>
							{link.label}
						</a>
					))
				}
			</div>
		</details>
		{
			servicesMenu.map((group) => (
				<details>
					<summary>{group.title}</summary>
					<div class="proto-mobile-menu__group">
						{group.links.map((link) => (
							<a href={link.href}>{link.label}</a>
						))}
					</div>
				</details>
			))
		}
		<a href="#why-strataline">About</a>
		<div class="proto-mobile-menu__actions">
			<a href="#consultation">Request a Quote</a>
			<a href="tel:+14164715999">Call or Text (416) 471-5999</a>
		</div>
	</nav>
</div>

<script is:inline>
	const servicesMenuItem = document.querySelector('[data-services-menu-item]');
	const servicesMenuButton = document.querySelector('[data-services-menu-button]');
	const servicesMenuPanel = document.querySelector('[data-services-menu-panel]');
	const servicesBackdrop = document.querySelector('[data-services-backdrop]');
	const mobileMenuButton = document.querySelector('[data-menu-toggle]');
	const mobileMenu = document.querySelector('[data-mobile-menu]');
	const mobileMenuLabel = document.querySelector('[data-menu-label]');
	const desktopMedia = window.matchMedia('(min-width: 901px)');
	let servicesMenuCloseTimer = 0;

	const desktopMenuIsOpen = () => servicesMenuButton?.getAttribute('aria-expanded') === 'true';

	const cancelServicesMenuClose = () => window.clearTimeout(servicesMenuCloseTimer);

	const setServicesMenu = (open, options = {}) => {
		if (
			!(servicesMenuItem instanceof HTMLElement) ||
			!(servicesMenuButton instanceof HTMLButtonElement) ||
			!(servicesMenuPanel instanceof HTMLElement) ||
			!(servicesBackdrop instanceof HTMLElement)
		) {
			return;
		}

		cancelServicesMenuClose();
		const shouldOpen = open && desktopMedia.matches;
		servicesMenuItem.dataset.menuOpen = String(shouldOpen);
		servicesMenuPanel.dataset.menuOpen = String(shouldOpen);
		servicesBackdrop.dataset.menuOpen = String(shouldOpen);
		servicesMenuButton.setAttribute('aria-expanded', String(shouldOpen));
		servicesMenuPanel.setAttribute('aria-hidden', String(!shouldOpen));
		servicesMenuPanel.inert = !shouldOpen;
		document.documentElement.classList.toggle('proto-services-open', shouldOpen);

		if (!shouldOpen && options.returnFocus) servicesMenuButton.focus();
	};

	const scheduleServicesMenuClose = () => {
		cancelServicesMenuClose();
		servicesMenuCloseTimer = window.setTimeout(() => setServicesMenu(false), 180);
	};

	const mobileMenuIsOpen = () => mobileMenuButton?.getAttribute('aria-expanded') === 'true';

	const setMobileMenu = (open, options = {}) => {
		if (!(mobileMenuButton instanceof HTMLButtonElement) || !(mobileMenu instanceof HTMLElement)) {
			return;
		}

		mobileMenuButton.setAttribute('aria-expanded', String(open));
		mobileMenu.hidden = !open;
		document.body.classList.toggle('proto-mobile-menu-open', open);
		if (mobileMenuLabel) mobileMenuLabel.textContent = open ? 'Close menu' : 'Open menu';

		if (open) {
			const firstControl = mobileMenu.querySelector('summary, a');
			if (firstControl instanceof HTMLElement) firstControl.focus();
		} else if (options.returnFocus) {
			mobileMenuButton.focus();
		}
	};

	if (
		servicesMenuItem instanceof HTMLElement &&
		servicesMenuButton instanceof HTMLButtonElement &&
		servicesMenuPanel instanceof HTMLElement &&
		servicesBackdrop instanceof HTMLElement
	) {
		servicesMenuPanel.inert = true;
		servicesMenuItem.addEventListener('pointerenter', () => setServicesMenu(true));
		servicesMenuItem.addEventListener('pointerleave', scheduleServicesMenuClose);
		servicesMenuPanel.addEventListener('pointerenter', cancelServicesMenuClose);
		servicesMenuPanel.addEventListener('pointerleave', scheduleServicesMenuClose);
		servicesBackdrop.addEventListener('pointerenter', cancelServicesMenuClose);
		servicesBackdrop.addEventListener('pointerleave', scheduleServicesMenuClose);
		servicesBackdrop.addEventListener('click', () => setServicesMenu(false));
		servicesMenuItem.addEventListener('focusin', () => setServicesMenu(true));
		servicesMenuButton.addEventListener('click', () => setServicesMenu(true));
		servicesMenuButton.addEventListener('keydown', (event) => {
			if (event.key === 'Enter' || event.key === ' ' || event.key === 'ArrowDown') {
				event.preventDefault();
				setServicesMenu(true);
				const firstLink = servicesMenuPanel.querySelector('a');
				if (firstLink instanceof HTMLAnchorElement) firstLink.focus();
			}
		});
		servicesMenuPanel.addEventListener('click', (event) => {
			if (event.target instanceof HTMLAnchorElement) setServicesMenu(false);
		});
		document.addEventListener('focusin', () => {
			if (!desktopMenuIsOpen()) return;
			const active = document.activeElement;
			if (
				active instanceof Node &&
				!servicesMenuItem.contains(active) &&
				!servicesMenuPanel.contains(active)
			) {
				setServicesMenu(false);
			}
		});
	}

	if (mobileMenuButton instanceof HTMLButtonElement && mobileMenu instanceof HTMLElement) {
		mobileMenuButton.addEventListener('click', () => setMobileMenu(!mobileMenuIsOpen()));
		mobileMenu.addEventListener('click', (event) => {
			if (event.target instanceof HTMLAnchorElement) setMobileMenu(false);
		});
	}

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			if (mobileMenuIsOpen()) setMobileMenu(false, { returnFocus: true });
			else if (desktopMenuIsOpen()) setServicesMenu(false, { returnFocus: true });
			return;
		}

		if (event.key === 'Tab' && mobileMenuIsOpen() && mobileMenu instanceof HTMLElement) {
			const focusable = [
				...mobileMenu.querySelectorAll('summary, a[href], button:not([disabled])'),
			].filter((element) => element instanceof HTMLElement && element.offsetParent !== null);
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last?.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first?.focus();
			}
		}
	});

	desktopMedia.addEventListener('change', () => {
		setServicesMenu(false);
		setMobileMenu(false);
	});
</script>
