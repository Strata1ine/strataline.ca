---
const phone = '(416) 471-5999';
interface Props {
	reveal?: boolean;
	formId?: string;
	mode?: 'inline' | 'popup';
	defaultProjectType?: string;
	projectHelperText?: string;
	eventPrefix?: string;
	startEventName?: string;
	submitEventName?: string;
}
const {
	reveal = true,
	formId = 'consultation',
	mode = 'inline',
	defaultProjectType,
	projectHelperText,
	eventPrefix,
	startEventName,
	submitEventName,
} = Astro.props;
const titleId = `${formId}-title`;
const attachmentId = `${formId}-attachments`;
const attachmentHelpId = `${attachmentId}-help`;
const attachmentErrorId = `${attachmentId}-error`;
const attachmentLabel =
	defaultProjectType === 'Popcorn ceiling removal'
		? 'Attach ceiling photos (optional)'
		: 'Attach photos or plans (optional)';
const budgetChoices = [
	'Under $15,000',
	'$15,000-$30,000',
	'$30,000-$60,000',
	'$60,000-$100,000',
	'$100,000+',
	'Not sure yet',
];
---

<section class="proto-consultation">
	<form
		class:list={['proto-consultation__form section-anchor', reveal && 'reveal']}
		id={formId}
		action="/api/contact"
		method="post"
		enctype="multipart/form-data"
		data-progressive-form
		data-contact-mode={mode}
		data-event-prefix={eventPrefix}
		data-start-event-name={startEventName}
		data-submit-event-name={submitEventName}
		data-attachment-max-files="10"
		data-attachment-max-bytes="4194304"
		aria-labelledby={titleId}
	>
		<input type="hidden" name="_redirect" value="https://strataline.ca/submissions/talk" />
		<input type="hidden" name="Contact Form Source" value={mode} />
		<label class="proto-honeypot" aria-hidden="true">
			<span>Leave this field empty</span>
			<input name="Company Website" tabindex="-1" autocomplete="off" />
		</label>

		<div data-form-flow>
			<div class="proto-consultation__intro" data-form-intro>
				<p class="proto-eyebrow">Project inquiry</p>
				<h2 id={titleId}>
					Tell us about your <span class="proto-no-break">project</span>
				</h2>
				<p>A few details will help us understand the scope before we contact you.</p>
			</div>

			<div class="proto-form-step" data-form-step="1">
				<div class="proto-form-progress">
					<h3 class="proto-form-step__label" tabindex="-1" data-form-heading>
						Step 1 of 2 <span>— Project</span>
					</h3>
					<span class="proto-form-progress__track" aria-hidden="true"><span></span></span>
				</div>
				<div class="proto-consultation__fields">
					<label>
						<span>Project type</span>
						<select name="Project Type" required>
							<option value="">Select one</option>
							<option selected={defaultProjectType === 'Popcorn ceiling removal'}
								>Popcorn ceiling removal</option
							>
							<option>Complete interior renovation</option>
							<option>Stairs and railings</option>
							<option>Ceilings and walls</option>
							<option>Kitchen or bathroom</option>
							<option>Doors, windows or finishing details</option>
							<option>Not sure yet</option>
						</select>
						{
							projectHelperText && (
								<small class="proto-form-field-helper">
									{projectHelperText} <a href="tel:+14164715999">(416) 471-5999</a>.
								</small>
							)
						}
					</label>
					<label>
						<span>Property city</span>
						<input name="Property City" autocomplete="address-level2" required />
					</label>
					<label>
						<span>Occupancy</span>
						<select name="Occupancy" required>
							<option value="">Select one</option>
							<option>Occupied</option>
							<option>Vacant</option>
							<option>Pre-move-in</option>
						</select>
					</label>
					<label>
						<span>Preferred start window</span>
						<select name="Preferred Start Window" required>
							<option value="">Select one</option>
							<option>As soon as practical</option>
							<option>Within 1-3 months</option>
							<option>3+ months away</option>
							<option>Flexible</option>
						</select>
					</label>
					<label class="proto-consultation__field-wide">
						<span>Approximate budget</span>
						<select name="Approximate Budget" required>
							<option value="">Select one</option>
							{budgetChoices.map((choice) => <option>{choice}</option>)}
						</select>
					</label>
				</div>
				<div class="proto-form-next">
					<div class="proto-form-next__contact">
						<p class="proto-form-reassurance">
							<span aria-hidden="true">✓</span> Get a reply within 12 hours.
						</p>
						<p class="proto-form-contact-alternative">
							<span>Prefer to talk?</span>
							<a href="tel:+14164715999">Call or text {phone}</a>
						</p>
					</div>
					<button class="proto-button proto-button--primary" type="button" data-form-next>
						Continue
					</button>
				</div>
			</div>

			<div class="proto-form-step" data-form-step="2">
				<div class="proto-form-progress proto-form-progress--complete">
					<h3 class="proto-form-step__label" tabindex="-1" data-form-heading>
						Step 2 of 2 <span>— Contact</span>
					</h3>
					<span class="proto-form-progress__track" aria-hidden="true"><span></span></span>
				</div>
				<div class="proto-form-step__intro">
					<h4>Your contact details</h4>
				</div>
				<div class="proto-consultation__fields">
					<label>
						<span>Name</span>
						<input name="Name" autocomplete="name" required />
					</label>
					<label>
						<span>Email</span>
						<input type="email" name="Email" autocomplete="email" required />
					</label>
					<label>
						<span>Phone</span>
						<input type="tel" name="Phone" autocomplete="tel" />
					</label>
					<label>
						<span>Property address</span>
						<input name="Property Address" autocomplete="street-address" />
					</label>
					<div class="proto-consultation__field-wide proto-upload-field" data-file-upload>
						<label class="proto-upload-field__label" for={attachmentId}>{attachmentLabel}</label>
						<p class="proto-upload-field__help" id={attachmentHelpId}>
							Photos of the space help us understand the scope faster.
							<span>JPG, PNG, WEBP, HEIC, HEIF or PDF · up to 10 files, 4 MB total.</span>
						</p>
						<input
							class="proto-upload-field__input"
							id={attachmentId}
							type="file"
							name="Attachments"
							accept=".jpg,.jpeg,.png,.webp,.heic,.heif,.pdf,image/jpeg,image/png,image/webp,image/heic,image/heif,application/pdf"
							multiple
							tabindex="-1"
							aria-describedby={`${attachmentHelpId} ${attachmentErrorId}`}
							data-file-input
						/>
						<button
							class="proto-upload-field__button"
							type="button"
							aria-controls={attachmentId}
							aria-describedby={`${attachmentHelpId} ${attachmentErrorId}`}
							data-file-picker
						>
							<span aria-hidden="true">+</span> Add photos or files
						</button>
						<p
							class="proto-upload-field__error"
							id={attachmentErrorId}
							role="alert"
							data-file-error
							hidden
						>
						</p>
						<ul
							class="proto-upload-field__list"
							aria-label="Selected attachments"
							aria-live="polite"
							data-file-list
							hidden
						>
						</ul>
					</div>
					<label class="proto-consultation__field-wide">
						<span>Project description</span>
						<textarea
							name="Project Details"
							rows="2"
							required
							placeholder="List the rooms, surfaces and connected work you are considering."
						></textarea>
					</label>
				</div>
				<p class="proto-consultation__privacy">
					Your information is used only to review and respond to your project inquiry.
				</p>
				<div class="proto-form-submit-actions">
					<button class="proto-button proto-button--primary" type="submit" data-form-submit>
						Submit Project Details
					</button>
					<button class="proto-form-back" type="button" data-form-back>← Back</button>
				</div>
			</div>
			<p class="proto-form-status" role="status" aria-live="polite" data-form-status></p>
		</div>

		<div class="proto-form-success" data-form-success hidden tabindex="-1">
			<p class="proto-eyebrow">Project inquiry received</p>
			<h2>Thank you — we received your project details.</h2>
			<p>We’ll review the information and reply within 12 hours.</p>
			<p class="proto-form-phone">
				Need to reach us sooner? <a href="tel:+14164715999">{phone}</a>
			</p>
		</div>
	</form>
</section>

<script is:inline>
	{
		const attachmentGenericMimes = new Set(['', 'application/octet-stream']);
		const attachmentMimeByKind = {
			jpeg: ['image/jpeg', 'image/jpg'],
			png: ['image/png'],
			webp: ['image/webp'],
			heic: ['image/heic', 'image/heif'],
			heif: ['image/heif', 'image/heic'],
			pdf: ['application/pdf'],
		};
		const attachmentExtensionsByKind = {
			jpeg: ['jpg', 'jpeg'],
			png: ['png'],
			webp: ['webp'],
			heic: ['heic'],
			heif: ['heif'],
			pdf: ['pdf'],
		};
		const heicBrands = new Set(['heic', 'heix', 'hevc', 'hevx', 'heim', 'heis']);
		const heifBrands = new Set(['heif', 'mif1', 'msf1']);
		const hasAttachmentBytes = (bytes, offset, expected) =>
			expected.every((byte, index) => bytes[offset + index] === byte);
		const attachmentAscii = (bytes, start, length) =>
			String.fromCharCode(...bytes.slice(start, start + length));
		const attachmentExtension = (filename) => filename.split('.').pop()?.toLowerCase() ?? '';

		const detectAttachmentKind = async (file) => {
			let bytes;
			try {
				bytes = new Uint8Array(await file.slice(0, 32).arrayBuffer());
			} catch {
				return null;
			}
			let kind = null;
			if (bytes.length >= 3 && hasAttachmentBytes(bytes, 0, [0xff, 0xd8, 0xff])) {
				kind = 'jpeg';
			} else if (
				bytes.length >= 8 &&
				hasAttachmentBytes(bytes, 0, [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])
			) {
				kind = 'png';
			} else if (
				bytes.length >= 12 &&
				attachmentAscii(bytes, 0, 4) === 'RIFF' &&
				attachmentAscii(bytes, 8, 4) === 'WEBP'
			) {
				kind = 'webp';
			} else if (bytes.length >= 12 && attachmentAscii(bytes, 4, 4) === 'ftyp') {
				const brands = [];
				for (let offset = 8; offset + 4 <= bytes.length; offset += 4) {
					if (offset !== 12) brands.push(attachmentAscii(bytes, offset, 4));
				}
				if (brands.some((brand) => heicBrands.has(brand))) kind = 'heic';
				else if (brands.some((brand) => heifBrands.has(brand))) kind = 'heif';
			} else if (bytes.length >= 5 && attachmentAscii(bytes, 0, 5) === '%PDF-') {
				kind = 'pdf';
			}

			if (!kind) return null;
			const extension = attachmentExtension(file.name);
			if ((kind === 'heic' || kind === 'heif') && (extension === 'heic' || extension === 'heif')) {
				kind = extension;
			}
			const declaredMime = file.type.toLowerCase();
			if (!attachmentExtensionsByKind[kind]?.includes(extension)) return null;
			if (
				!attachmentGenericMimes.has(declaredMime) &&
				!attachmentMimeByKind[kind]?.includes(declaredMime)
			) {
				return null;
			}
			return kind;
		};

		const initializeProgressiveForm = (progressiveForm) => {
			if (!(progressiveForm instanceof HTMLFormElement) || progressiveForm.dataset.initialized)
				return;
			progressiveForm.dataset.initialized = 'true';
			progressiveForm.classList.add('is-enhanced');
			const contactMode = progressiveForm.dataset.contactMode === 'popup' ? 'popup' : 'inline';
			const eventPrefix = progressiveForm.dataset.eventPrefix;
			const eventName = (action) => {
				if (action === 'start' && progressiveForm.dataset.startEventName) {
					return progressiveForm.dataset.startEventName;
				}
				if (action === 'submit' && progressiveForm.dataset.submitEventName) {
					return progressiveForm.dataset.submitEventName;
				}
				return eventPrefix
					? `${eventPrefix}_form_${action}_${contactMode}`
					: `contact_form_${action}_${contactMode}`;
			};
			const steps = [...progressiveForm.querySelectorAll('[data-form-step]')];
			const nextButton = progressiveForm.querySelector('[data-form-next]');
			const backButton = progressiveForm.querySelector('[data-form-back]');
			const status = progressiveForm.querySelector('[data-form-status]');
			const submitButton = progressiveForm.querySelector('[data-form-submit]');
			const formFlow = progressiveForm.querySelector('[data-form-flow]');
			const formIntro = progressiveForm.querySelector('[data-form-intro]');
			const successState = progressiveForm.querySelector('[data-form-success]');
			const fileInput = progressiveForm.querySelector('[data-file-input]');
			const filePicker = progressiveForm.querySelector('[data-file-picker]');
			const fileList = progressiveForm.querySelector('[data-file-list]');
			const fileError = progressiveForm.querySelector('[data-file-error]');
			const maxAttachmentFiles = Number(progressiveForm.dataset.attachmentMaxFiles) || 10;
			const maxAttachmentBytes =
				Number(progressiveForm.dataset.attachmentMaxBytes) || 4 * 1024 * 1024;
			let selectedAttachments = [];
			let attachmentPreviewUrls = [];
			let pendingAttachmentValidation = Promise.resolve();
			let hasStarted = false;
			let currentStep = 1;
			let isSubmitting = false;
			const markStarted = () => {
				if (hasStarted) return;
				window.trackContactEvent?.(eventName('start'));
				hasStarted = true;
			};

			const setStatus = (message) => {
				if (status) status.textContent = message;
			};

			const setFileError = (message) => {
				if (!(fileError instanceof HTMLElement)) return;
				fileError.textContent = message;
				fileError.hidden = !message;
			};

			const setAttachmentControlsDisabled = (disabled) => {
				if (filePicker instanceof HTMLButtonElement) filePicker.disabled = disabled;
				if (fileInput instanceof HTMLInputElement) fileInput.disabled = disabled;
				fileList?.querySelectorAll('[data-file-remove]').forEach((button) => {
					if (button instanceof HTMLButtonElement) button.disabled = disabled;
				});
			};

			const revokeAttachmentPreviews = () => {
				attachmentPreviewUrls.forEach((url) => URL.revokeObjectURL(url));
				attachmentPreviewUrls = [];
			};

			const attachmentSizeLabel = (bytes) => `${Math.max(1, Math.ceil(bytes / 1024))} KB`;

			const renderAttachments = () => {
				if (!(fileList instanceof HTMLUListElement)) return;
				revokeAttachmentPreviews();
				fileList.replaceChildren();
				fileList.hidden = selectedAttachments.length === 0;
				selectedAttachments.forEach((attachment, index) => {
					const item = document.createElement('li');
					item.className = 'proto-upload-file';

					const preview = document.createElement('span');
					preview.className = 'proto-upload-file__preview';
					if (['jpeg', 'png', 'webp'].includes(attachment.kind)) {
						const image = document.createElement('img');
						const previewUrl = URL.createObjectURL(attachment.file);
						attachmentPreviewUrls.push(previewUrl);
						image.src = previewUrl;
						image.alt = '';
						preview.append(image);
					} else {
						preview.textContent = attachment.kind === 'pdf' ? 'PDF' : 'IMG';
						preview.setAttribute('aria-hidden', 'true');
					}

					const details = document.createElement('span');
					details.className = 'proto-upload-file__details';
					const name = document.createElement('span');
					name.className = 'proto-upload-file__name';
					name.textContent = attachment.file.name;
					const size = document.createElement('span');
					size.className = 'proto-upload-file__size';
					size.textContent = attachmentSizeLabel(attachment.file.size);
					details.append(name, size);

					const removeButton = document.createElement('button');
					removeButton.className = 'proto-upload-file__remove';
					removeButton.type = 'button';
					removeButton.textContent = '×';
					removeButton.dataset.fileRemove = '';
					removeButton.disabled = isSubmitting;
					removeButton.setAttribute('aria-label', `Remove ${attachment.file.name}`);
					removeButton.addEventListener('click', () => {
						if (isSubmitting) return;
						selectedAttachments.splice(index, 1);
						setFileError('');
						renderAttachments();
						markStarted();
						if (filePicker instanceof HTMLElement) filePicker.focus();
					});
					item.append(preview, details, removeButton);
					fileList.append(item);
				});
			};

			const clearAttachments = () => {
				selectedAttachments = [];
				if (fileInput instanceof HTMLInputElement) fileInput.value = '';
				setFileError('');
				renderAttachments();
			};

			const addAttachments = async (files) => {
				const errors = [];
				const existing = new Set(
					selectedAttachments.map(
						(attachment) =>
							`${attachment.file.name}|${attachment.file.size}|${attachment.file.lastModified}`,
					),
				);
				let totalBytes = selectedAttachments.reduce(
					(total, attachment) => total + attachment.file.size,
					0,
				);

				for (const file of files) {
					const identity = `${file.name}|${file.size}|${file.lastModified}`;
					if (existing.has(identity)) {
						errors.push(`${file.name} is already attached.`);
						continue;
					}
					if (selectedAttachments.length >= maxAttachmentFiles) {
						errors.push(`Only ${maxAttachmentFiles} files can be attached at a time.`);
						break;
					}
					if (!file.size) {
						errors.push(`${file.name || 'A selected file'} is empty and wasn't added.`);
						continue;
					}
					if (file.size > maxAttachmentBytes || totalBytes + file.size > maxAttachmentBytes) {
						errors.push(`${file.name} wasn't added because the total upload limit is 4 MB.`);
						continue;
					}
					const kind = await detectAttachmentKind(file);
					if (!kind) {
						errors.push(
							`${file.name} isn't supported. Please use JPG, PNG, WEBP, HEIC, HEIF or PDF.`,
						);
						continue;
					}

					selectedAttachments.push({ file, kind });
					existing.add(identity);
					totalBytes += file.size;
				}

				setFileError(errors.join(' '));
				renderAttachments();
				if (selectedAttachments.length) markStarted();
			};

			filePicker?.addEventListener('click', () => {
				if (fileInput instanceof HTMLInputElement) fileInput.click();
			});
			fileInput?.addEventListener('change', () => {
				if (!(fileInput instanceof HTMLInputElement)) return;
				const files = [...(fileInput.files ?? [])];
				fileInput.value = '';
				pendingAttachmentValidation = pendingAttachmentValidation.then(() => addAttachments(files));
			});

			const setStep = (step) => {
				currentStep = step;
				if (formIntro instanceof HTMLElement) formIntro.hidden = step !== 1;
				steps.forEach((element) => {
					const active = element.getAttribute('data-form-step') === String(step);
					element.hidden = !active;
				});
				setStatus('');
			};

			const focusStep = (step) => {
				const heading = progressiveForm.querySelector(
					`[data-form-step="${step}"] [data-form-heading]`,
				);
				if (heading instanceof HTMLElement) heading.focus();
			};

			const validateStep = (step) => {
				const fields = steps[step - 1]?.querySelectorAll('input, select, textarea') ?? [];
				return [...fields].every((field) => {
					if (
						!(
							field instanceof HTMLInputElement ||
							field instanceof HTMLSelectElement ||
							field instanceof HTMLTextAreaElement
						)
					) {
						return true;
					}
					return field.reportValidity();
				});
			};

			nextButton?.addEventListener('click', () => {
				markStarted();
				if (!validateStep(1)) {
					setStatus('Please complete Step 1 before continuing.');
					return;
				}
				window.trackContactEvent?.(eventName('step_complete'), { step: 1 });
				setStep(2);
				focusStep(2);
			});

			progressiveForm.addEventListener('input', markStarted);

			backButton?.addEventListener('click', () => {
				setStep(1);
				focusStep(1);
			});

			progressiveForm.addEventListener('keydown', (event) => {
				if (
					event.key !== 'Enter' ||
					currentStep !== 1 ||
					event.target instanceof HTMLTextAreaElement ||
					event.target instanceof HTMLButtonElement
				) {
					return;
				}
				event.preventDefault();
				nextButton?.click();
			});

			progressiveForm.addEventListener('submit', async (event) => {
				if (currentStep !== 2) {
					event.preventDefault();
					nextButton?.click();
					return;
				}
				if (!(submitButton instanceof HTMLButtonElement) || !window.fetch) return;
				event.preventDefault();
				if (isSubmitting) return;
				isSubmitting = true;
				submitButton.disabled = true;
				setAttachmentControlsDisabled(true);

				try {
					await pendingAttachmentValidation;
					if (!validateStep(1) || !validateStep(2) || !progressiveForm.reportValidity()) {
						setStatus('Please complete the required fields before submitting.');
						return;
					}
					setStatus('Sending project details...');
					const formData = new FormData(progressiveForm);
					formData.delete('Attachments');
					selectedAttachments.forEach(({ file }) => {
						formData.append('Attachments', file, file.name);
					});
					const response = await fetch(progressiveForm.action, {
						method: 'POST',
						body: formData,
						headers: { Accept: 'application/json' },
					});
					const responseData = await response.json().catch(() => null);
					if (!response.ok || responseData?.ok === false) {
						const submissionError = new Error(
							responseData?.error || 'The form could not send. Please try again or call us.',
						);
						submissionError.userFacing = true;
						throw submissionError;
					}
					window.trackContactEvent?.(eventName('submit'));
					progressiveForm.reset();
					clearAttachments();
					setStatus('');
					if (formFlow instanceof HTMLElement) formFlow.hidden = true;
					if (successState instanceof HTMLElement) {
						successState.hidden = false;
						successState.focus();
					}
				} catch (error) {
					window.trackContactEvent?.(eventName('error'));
					setStatus(
						error?.userFacing
							? error.message
							: 'The form could not send. Please call or text us before trying again.',
					);
				} finally {
					isSubmitting = false;
					submitButton.disabled = false;
					setAttachmentControlsDisabled(false);
				}
			});

			setStep(1);
		};

		document.querySelectorAll('[data-progressive-form]').forEach(initializeProgressiveForm);
		document.addEventListener('strataline:initialize-contact-forms', () => {
			document.querySelectorAll('[data-progressive-form]').forEach(initializeProgressiveForm);
		});
	}
</script>
