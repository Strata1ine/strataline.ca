---
import { Image } from 'astro:assets';
import {
	featuredMedia,
	type FeaturedMediaArticle,
	type FeaturedMediaItem,
	type FeaturedMediaVideo,
} from '@/data/interiorRenovationsPrototype';

interface Props {
	items?: FeaturedMediaItem[];
	selectEventName?: string;
	playEventName?: string;
}

const {
	items = featuredMedia,
	selectEventName = 'media_video_select',
	playEventName = 'media_video_play',
} = Astro.props;
const videos = items.filter((item): item is FeaturedMediaVideo => item.type === 'video');
const articles = items.filter((item): item is FeaturedMediaArticle => item.type === 'article');
const activeVideo = videos[0];
if (!activeVideo) throw new Error('HomepageMediaWatch requires at least one video item.');
---

<div
	class="media-watch"
	data-media-watch
	data-active-id={activeVideo.id}
	data-select-event-name={selectEventName}
	data-play-event-name={playEventName}
>
	<article class="media-watch__active">
		<div class="media-watch__player">
			<video
				controls
				playsinline
				preload="metadata"
				poster={activeVideo.poster.src.src}
				data-active-video
			>
				<source src={activeVideo.videoSrc} type="video/mp4" data-active-source />
			</video>
		</div>
		<div class="media-watch__active-copy" aria-live="polite" aria-atomic="true">
			<p data-active-source-name>{activeVideo.source}</p>
			<h3 data-active-title>{activeVideo.title}</h3>
		</div>
	</article>

	<aside class="media-watch__rail">
		<section
			class="media-watch__videos"
			aria-labelledby="media-video-queue-heading"
			hidden={videos.length < 2}
		>
			<h3 id="media-video-queue-heading">More videos</h3>
			<div class="media-watch__video-list" data-video-queue>
				{
					videos.slice(1).map((video) => (
						<button
							class="media-watch__video-option"
							type="button"
							data-video-option
							data-video-id={video.id}
							data-video-source={video.source}
							data-video-title={video.title}
							data-video-src={video.videoSrc}
							data-video-poster={video.poster.src.src}
							aria-label={`Watch ${video.title}`}
						>
							<span class="media-watch__video-thumb">
								<Image
									src={video.poster.src}
									alt=""
									widths={[240, 360, 480]}
									sizes="(max-width: 900px) 38vw, 12vw"
									loading="lazy"
								/>
								<span aria-hidden="true">Watch feature</span>
							</span>
							<span class="media-watch__video-copy">
								<span class="media-watch__source">{video.source}</span>
								<strong>{video.title}</strong>
								{video.duration && <span class="media-watch__duration">{video.duration}</span>}
							</span>
						</button>
					))
				}
			</div>
		</section>

		<section class="media-watch__press" aria-labelledby="media-press-heading">
			<h3 id="media-press-heading">Press coverage</h3>
			<div class="media-watch__press-list">
				{
					articles.map((article) => (
						<a
							class="media-watch__press-card"
							href={article.url}
							target="_blank"
							rel="noopener noreferrer"
						>
							<span class="media-watch__press-thumb">
								<Image
									src={article.image.src}
									alt={article.image.alt}
									widths={[240, 360, 480]}
									sizes="(max-width: 900px) 34vw, 10vw"
									loading="lazy"
								/>
							</span>
							<span class="media-watch__press-copy">
								<span class="media-watch__source">{article.source}</span>
								<strong>{article.title}</strong>
								<span class="media-watch__article-cta">
									{article.cta} <span aria-hidden="true">&#8599;</span>
								</span>
							</span>
						</a>
					))
				}
			</div>
		</section>
	</aside>
</div>

<style>
	.media-watch {
		display: grid;
		grid-template-columns: minmax(0, 1.42fr) minmax(20rem, 0.9fr);
		gap: clamp(1rem, 2vw, 1.5rem);
		width: min(84rem, 100%);
		margin: 0 auto;
	}

	.media-watch__active,
	.media-watch__videos,
	.media-watch__press {
		min-width: 0;
		margin: 0;
	}

	.media-watch__active {
		overflow: hidden;
		border: 1px solid rgba(76, 53, 36, 0.16);
		border-radius: 1.25rem;
		background: rgba(255, 255, 255, 0.76);
		box-shadow: 0 18px 44px rgba(65, 42, 25, 0.1);
	}

	.media-watch__player {
		aspect-ratio: 16 / 9;
		background: #181512;
	}

	.media-watch__player video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.media-watch__active-copy {
		display: grid;
		gap: 0.55rem;
		padding: clamp(1.15rem, 2vw, 1.65rem);
	}

	.media-watch__active-copy p,
	.media-watch__source {
		margin: 0;
		color: #9a5a27;
		font-family: var(--font-sans, system-ui, sans-serif);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.media-watch__active-copy h3 {
		margin: 0;
		font-family: var(--font-source-serif-4), Georgia, serif;
		font-size: clamp(1.7rem, 2.6vw, 2.65rem);
		font-weight: 500;
		line-height: 1.05;
	}

	.media-watch__rail {
		display: grid;
		min-width: 0;
		align-content: start;
		gap: 1.25rem;
	}

	.media-watch__videos,
	.media-watch__press {
		display: grid;
		gap: 0.7rem;
	}

	.media-watch__videos > h3,
	.media-watch__press > h3 {
		margin: 0;
		font-family: var(--font-sans, system-ui, sans-serif);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.media-watch__video-list {
		display: grid;
		max-height: 22rem;
		gap: 0.7rem;
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-width: thin;
		scrollbar-color: rgba(117, 76, 39, 0.35) transparent;
	}

	.media-watch__video-option,
	.media-watch__press-card {
		display: grid;
		grid-template-columns: minmax(7.5rem, 42%) minmax(0, 1fr);
		min-width: 0;
		overflow: hidden;
		border: 1px solid rgba(76, 53, 36, 0.14);
		border-radius: 1rem;
		background: rgba(255, 255, 255, 0.72);
		color: inherit;
		box-shadow: 0 10px 26px rgba(65, 42, 25, 0.07);
		text-align: left;
		text-decoration: none;
	}

	.media-watch__video-option {
		width: 100%;
		padding: 0;
		font: inherit;
		cursor: pointer;
	}

	.media-watch__video-option:hover,
	.media-watch__press-card:hover {
		border-color: rgba(154, 90, 39, 0.38);
		background: rgba(255, 255, 255, 0.94);
	}

	.media-watch__video-option:focus-visible,
	.media-watch__press-card:focus-visible {
		outline: 3px solid rgba(154, 90, 39, 0.42);
		outline-offset: 3px;
	}

	.media-watch__video-thumb,
	.media-watch__press-thumb {
		position: relative;
		display: block;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #e7dfd5;
	}

	.media-watch__video-thumb :global(img),
	.media-watch__press-thumb :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.media-watch__video-thumb > span {
		position: absolute;
		right: 0.5rem;
		bottom: 0.5rem;
		padding: 0.35rem 0.5rem;
		border-radius: 999px;
		background: rgba(28, 23, 19, 0.88);
		color: white;
		font-family: var(--font-sans, system-ui, sans-serif);
		font-size: 0.65rem;
		font-weight: 700;
	}

	.media-watch__video-copy,
	.media-watch__press-copy {
		display: grid;
		min-width: 0;
		align-content: center;
		gap: 0.42rem;
		padding: 0.85rem;
	}

	.media-watch__video-copy strong,
	.media-watch__press-copy strong {
		font-family: var(--font-source-serif-4), Georgia, serif;
		font-size: clamp(1.02rem, 1.4vw, 1.28rem);
		font-weight: 500;
		line-height: 1.08;
	}

	.media-watch__duration,
	.media-watch__article-cta {
		color: #9a5a27;
		font-family: var(--font-sans, system-ui, sans-serif);
		font-size: 0.76rem;
		font-weight: 700;
	}

	.media-watch__press-list {
		display: grid;
		gap: 0.7rem;
	}

	@media (max-width: 900px) {
		.media-watch {
			display: block;
		}

		.media-watch__rail {
			margin-top: 1.35rem;
			gap: 1.5rem;
		}

		.media-watch__video-list,
		.media-watch__press-list {
			display: flex;
			width: calc(100% + clamp(1rem, 4vw, 2rem));
			max-height: none;
			gap: 0.8rem;
			overflow-x: auto;
			overflow-y: hidden;
			scroll-snap-type: x mandatory;
			overscroll-behavior-inline: contain;
			padding: 0.2rem clamp(1rem, 4vw, 2rem) 0.65rem 0.1rem;
			scrollbar-width: thin;
		}

		.media-watch__video-option,
		.media-watch__press-card {
			grid-template-columns: 1fr;
			flex: 0 0 min(68vw, 25rem);
			scroll-snap-align: start;
		}

		.media-watch__video-copy,
		.media-watch__press-copy {
			align-content: start;
		}
	}

	@media (max-width: 640px) {
		.media-watch__active-copy {
			padding: 1rem;
		}

		.media-watch__active-copy h3 {
			font-size: 1.55rem;
		}

		.media-watch__video-option,
		.media-watch__press-card {
			flex-basis: 72vw;
		}
	}
</style>

<script is:inline>
	document.querySelectorAll('[data-media-watch]').forEach((watch) => {
		const player = watch.querySelector('[data-active-video]');
		const source = watch.querySelector('[data-active-source]');
		const sourceName = watch.querySelector('[data-active-source-name]');
		const title = watch.querySelector('[data-active-title]');
		const options = [...watch.querySelectorAll('[data-video-option]')];

		if (!(player instanceof HTMLVideoElement) || !(source instanceof HTMLSourceElement)) return;

		const selectVideo = async (option, restoreQueueFocus = false) => {
			if (!(option instanceof HTMLButtonElement)) return;
			const id = option.dataset.videoId;
			const videoSrc = option.dataset.videoSrc;
			if (!id || !videoSrc || id === watch.dataset.activeId) return;
			const previous = {
				id: watch.dataset.activeId ?? '',
				source: sourceName?.textContent ?? '',
				title: title?.textContent ?? '',
				videoSrc: source.src,
				poster: player.poster,
			};
			const next = {
				id,
				source: option.dataset.videoSource ?? '',
				title: option.dataset.videoTitle ?? '',
				videoSrc,
				poster: option.dataset.videoPoster ?? '',
			};

			player.pause();
			player.currentTime = 0;
			source.src = next.videoSrc;
			player.poster = next.poster;
			player.load();

			if (sourceName) sourceName.textContent = next.source;
			if (title) title.textContent = next.title;
			watch.dataset.activeId = next.id;

			option.dataset.videoId = previous.id;
			option.dataset.videoSource = previous.source;
			option.dataset.videoTitle = previous.title;
			option.dataset.videoSrc = previous.videoSrc;
			option.dataset.videoPoster = previous.poster;
			option.setAttribute('aria-label', `Watch ${previous.title}`);
			const optionSource = option.querySelector('.media-watch__source');
			const optionTitle = option.querySelector('.media-watch__video-copy strong');
			const optionImage = option.querySelector('img');
			if (optionSource) optionSource.textContent = previous.source;
			if (optionTitle) optionTitle.textContent = previous.title;
			if (optionImage instanceof HTMLImageElement) {
				optionImage.src = previous.poster;
				optionImage.removeAttribute('srcset');
			}
			if (restoreQueueFocus) {
				option.focus();
			}

			Reflect.get(
				window,
				'trackProtoEvent',
			)?.(watch.dataset.selectEventName ?? 'media_video_select');
			try {
				await player.play();
			} catch {
				// The selected video is loaded and ready if autoplay is unavailable.
			}
		};

		options.forEach((option) => {
			option.addEventListener('click', () => selectVideo(option));
			option.addEventListener('keydown', (event) => {
				if (event.key !== 'Enter' && event.key !== ' ') return;
				event.preventDefault();
				selectVideo(option, true);
			});
		});

		player.addEventListener('play', () =>
			Reflect.get(window, 'trackProtoEvent')?.(watch.dataset.playEventName ?? 'media_video_play'),
		);

		if ('IntersectionObserver' in window) {
			const observer = new IntersectionObserver(
				([entry]) => {
					if (!entry.isIntersecting) player.pause();
				},
				{ threshold: 0.15 },
			);
			observer.observe(watch);
		}
	});
</script>
