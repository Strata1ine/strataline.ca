---
import type { BeforeAfterComparison } from '@/data/interiorRenovationsPrototype';
import BeforeAfterViewer from './BeforeAfterViewer.astro';

interface Props {
	comparison: BeforeAfterComparison;
	eventName?: string;
}

const { comparison, eventName = 'before_after_interaction' } = Astro.props;
---

<section
	class:list={['proto-before-after', `proto-before-after--${comparison.theme}`, 'section-anchor']}
	id={comparison.id}
>
	<div class="proto-section-head reveal">
		<p class="proto-eyebrow">{comparison.eyebrow}</p>
		<h2>{comparison.title}</h2>
		<p>{comparison.description}</p>
	</div>

	<div class="reveal">
		<BeforeAfterViewer
			comparison={{
				id: comparison.id,
				title: comparison.title,
				beforeImage: comparison.beforeImage,
				afterImage: comparison.afterImage,
				beforeAlt: comparison.beforeAlt,
				afterAlt: comparison.afterAlt,
				beforeObjectPosition: comparison.objectPositionBefore,
				afterObjectPosition: comparison.objectPositionAfter,
			}}
			{eventName}
		/>
	</div>

	<nav class="proto-before-after__links reveal" aria-label={`${comparison.title} services`}>
		{comparison.links.map((link) => <a href={link.href}>{link.label}</a>)}
	</nav>
</section>
