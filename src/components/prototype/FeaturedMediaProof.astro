---
import { Image } from 'astro:assets';
import { featuredMedia } from '@/data/interiorRenovationsPrototype';
import asSeenOnTvBadge from '../../../content/awards/as-seen-on-tv-badge.webp';
import HomepageMediaWatch from './HomepageMediaWatch.astro';
import MediaFeatureCard from './MediaFeatureCard.astro';

interface Props {
	id?: string;
	variant?: 'default' | 'homepage';
}

const { id = 'media', variant = 'default' } = Astro.props;
const isHomepage = variant === 'homepage';
---

<section
	class:list={['proto-media-proof section-anchor', isHomepage && 'proto-media-proof--homepage']}
	{id}
>
	<div class="proto-media-proof__heading-wrap">
		<div class:list={['proto-as-seen-badge', !isHomepage && 'reveal']} aria-hidden="true">
			<Image
				src={asSeenOnTvBadge}
				alt=""
				widths={[96, 128, 160, 192, 256, 320]}
				sizes="(max-width: 640px) 24vw, 9vw"
				loading="lazy"
			/>
		</div>
		<div class:list={['proto-section-head', !isHomepage && 'reveal']}>
			{isHomepage && <p class="proto-media-proof__eyebrow">Media</p>}
			<h2>Featured by leading Canadian media</h2>
			<p>
				CityTV, HGTV, The Toronto Star and House & Home have featured Strataline’s renovation work,
				dust-controlled process and finishing expertise.
			</p>
		</div>
	</div>

	{
		isHomepage ? (
			<HomepageMediaWatch />
		) : (
			<div class="proto-media-proof__grid">
				{featuredMedia.map((item) => (
					<MediaFeatureCard item={item} />
				))}
			</div>
		)
	}
</section>

<style>
	.proto-media-proof--homepage {
		margin-top: 3rem;
		padding: clamp(3rem, 4vw, 4rem) clamp(1rem, 4vw, 4rem);
		background:
			linear-gradient(135deg, rgba(255, 252, 247, 0.96), rgba(244, 237, 227, 0.9)),
			radial-gradient(circle at 10% 0%, rgba(177, 117, 54, 0.11), transparent 42%);
		color: #241c17;
	}

	.proto-media-proof--homepage .proto-media-proof__heading-wrap {
		width: min(84rem, 100%);
	}

	.proto-media-proof--homepage .proto-media-proof__heading-wrap {
		display: grid;
		grid-template-columns: clamp(7.5rem, 10vw, 9.5rem) minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.5rem, 4vw, 3.5rem);
		margin-bottom: clamp(2rem, 3vw, 3rem);
	}

	.proto-media-proof--homepage .proto-as-seen-badge {
		position: static;
		width: clamp(7.5rem, 10vw, 9.5rem);
		transform: rotate(7deg);
		filter: drop-shadow(0 12px 18px rgba(81, 48, 22, 0.22));
	}

	.proto-media-proof--homepage .proto-section-head {
		width: min(58rem, 100%);
		margin: 0;
		padding: 0;
	}

	.proto-media-proof--homepage .proto-media-proof__eyebrow {
		margin: 0 0 0.7rem;
		color: #9a5a27;
		font-family: var(--font-sans, system-ui, sans-serif);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.proto-media-proof--homepage .proto-section-head h2 {
		font-size: clamp(2.35rem, 4.2vw, 4.35rem);
		line-height: 0.98;
	}

	.proto-media-proof--homepage .proto-section-head h2 + p {
		max-width: 55rem;
		margin-top: 1.1rem;
		font-size: clamp(1rem, 1.4vw, 1.18rem);
		line-height: 1.65;
	}

	@media (max-width: 900px) {
		.proto-media-proof--homepage {
			padding-inline: clamp(1rem, 4vw, 2rem);
			overflow: hidden;
		}
	}

	@media (max-width: 640px) {
		.proto-media-proof--homepage {
			margin-top: 2.5rem;
			padding-block: 2.5rem;
		}

		.proto-media-proof--homepage .proto-media-proof__heading-wrap {
			display: block;
			padding-top: 0;
			margin-bottom: 1.75rem;
		}

		.proto-media-proof--homepage .proto-as-seen-badge {
			position: absolute;
			top: 0;
			right: 0;
			width: 5.75rem;
		}

		.proto-media-proof--homepage .proto-section-head {
			padding-right: 0;
		}

		.proto-media-proof--homepage .proto-section-head h2 {
			max-width: none;
			padding-right: 5.9rem;
			font-size: clamp(1.95rem, 8vw, 2.25rem);
		}

		.proto-media-proof--homepage .proto-section-head h2 + p {
			margin-top: 1rem;
			padding-right: 0;
			font-size: 0.96rem;
			line-height: 1.55;
		}
	}
</style>

<script is:inline>
	const mediaCards = [...document.querySelectorAll('[data-proto-video-card]')];

	const pauseCard = (card) => {
		const video = card.querySelector('video');
		if (video instanceof HTMLVideoElement) video.pause();
	};

	mediaCards.forEach((card) => {
		const video = card.querySelector('video');
		const button = card.querySelector('[data-video-toggle]');
		const label = card.querySelector('[data-video-label]');

		if (!(video instanceof HTMLVideoElement) || !(button instanceof HTMLButtonElement)) return;
		video.controls = false;

		const sync = () => {
			const playing = !video.paused && !video.ended;
			const hasNativeControls = video.controls && !video.ended;
			button.hidden = hasNativeControls;
			card.classList.toggle('has-native-controls', hasNativeControls);
			button.setAttribute(
				'aria-label',
				`${playing ? 'Playing' : 'Watch'} ${card.querySelector('h3')?.textContent ?? 'feature video'}`,
			);
			button.setAttribute('aria-pressed', String(playing));
			if (label) label.textContent = 'Watch feature';
		};

		button.addEventListener('click', async () => {
			if (video.paused || video.ended) {
				mediaCards.forEach((otherCard) => {
					if (otherCard !== card) pauseCard(otherCard);
				});
				video.controls = true;
				button.hidden = true;
				try {
					await video.play();
				} catch {
					video.controls = false;
					button.hidden = false;
				}
			}
			sync();
		});

		video.addEventListener('play', () => {
			mediaCards.forEach((otherCard) => {
				if (otherCard !== card) pauseCard(otherCard);
			});
			video.controls = true;
			sync();
		});
		video.addEventListener('play', () => window.trackProtoEvent?.('media_video_play'));
		video.addEventListener('pause', sync);
		video.addEventListener('ended', () => {
			video.controls = false;
			sync();
		});
		sync();
	});

	if ('IntersectionObserver' in window) {
		const videoObserver = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) pauseCard(entry.target);
				}
			},
			{ threshold: 0.2 },
		);

		mediaCards.forEach((card) => videoObserver.observe(card));
	}
</script>
