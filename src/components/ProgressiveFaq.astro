---
export type ProgressiveFaqLink = {
	label: string;
	href: string;
};

export type ProgressiveFaqItem = {
	id?: string;
	question: string;
	answer?: string;
	answerHtml?: string;
	links?: ProgressiveFaqLink[];
};

interface Props {
	items: ProgressiveFaqItem[];
	eyebrow?: string;
	heading: string;
	supportingText?: string;
	sectionId?: string;
	pageId?: string;
	initialCount?: number;
}

const {
	items,
	eyebrow = 'FAQ',
	heading,
	supportingText,
	sectionId = 'faq',
	pageId = Astro.url.pathname,
	initialCount = 6,
} = Astro.props;

const slugify = (value: string) =>
	value
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '')
		.slice(0, 72);

const safeSectionId = slugify(sectionId) || 'faq';
const initialItems = items.slice(0, initialCount);
const extraItems = items.slice(initialCount);
const extraId = `${safeSectionId}-extra-questions`;
const showMoreLabel = `Show ${extraItems.length} more question${extraItems.length === 1 ? '' : 's'}`;
---

<div
	class="global-faq"
	data-progressive-faq
	data-expanded="false"
	data-page-id={pageId}
	data-section-id={safeSectionId}
>
	<span class="global-faq__watermark" aria-hidden="true">FAQ</span>
	<header class="global-faq__head">
		<p class="global-faq__eyebrow">{eyebrow}</p>
		<h2 id={`${safeSectionId}-title`}>{heading}</h2>
		{supportingText && <p class="global-faq__intro">{supportingText}</p>}
	</header>

	<div class="global-faq__list">
		{
			initialItems.map((item) => (
				<details class="global-faq__item" data-faq-question data-question-id={item.id ?? slugify(item.question)}>
					<summary>{item.question}</summary>
					<div class="global-faq__answer">
						{item.answerHtml ? <div set:html={item.answerHtml} /> : <p>{item.answer}</p>}
						{item.links && item.links.length > 0 && (
							<p class="global-faq__links">
								{item.links.map((link) => <a href={link.href}>{link.label}</a>)}
							</p>
						)}
					</div>
				</details>
			))
		}
	</div>

	{
		extraItems.length > 0 && (
			<>
				<div class="global-faq__action">
					<button
						type="button"
						aria-controls={extraId}
						aria-expanded="false"
						data-faq-toggle
						data-show-more-label={showMoreLabel}
						hidden
					>
						{showMoreLabel}
					</button>
				</div>
				<div class="global-faq__list global-faq__list--extra" id={extraId} data-faq-extra>
					{extraItems.map((item) => (
						<details class="global-faq__item" data-faq-question data-question-id={item.id ?? slugify(item.question)}>
							<summary>{item.question}</summary>
							<div class="global-faq__answer">
								{item.answerHtml ? <div set:html={item.answerHtml} /> : <p>{item.answer}</p>}
								{item.links && item.links.length > 0 && (
									<p class="global-faq__links">
										{item.links.map((link) => <a href={link.href}>{link.label}</a>)}
									</p>
								)}
							</div>
						</details>
					))}
				</div>
			</>
		)
	}
</div>

<script>
	const analytics = (name: string, params: Record<string, string>) => {
		const tracker = Reflect.get(window, 'trackContactEvent') ?? Reflect.get(window, 'trackProtoEvent');
		if (typeof tracker === 'function') tracker(name, params);
	};

	document.querySelectorAll<HTMLElement>('[data-progressive-faq]').forEach((root) => {
		if (root.dataset.faqReady === 'true') return;
		root.dataset.faqReady = 'true';
		root.dataset.enhanced = 'true';

		const toggle = root.querySelector<HTMLButtonElement>('[data-faq-toggle]');
		const extra = root.querySelector<HTMLElement>('[data-faq-extra]');
		if (toggle && extra) {
			toggle.hidden = false;
			extra.setAttribute('aria-hidden', 'true');
			toggle.addEventListener('click', () => {
				const expanded = toggle.getAttribute('aria-expanded') !== 'true';
				toggle.setAttribute('aria-expanded', String(expanded));
				toggle.textContent = expanded ? 'Show fewer questions' : toggle.dataset.showMoreLabel ?? 'Show more questions';
				root.dataset.expanded = String(expanded);
				extra.setAttribute('aria-hidden', String(!expanded));
				if (expanded) {
					analytics('faq_show_more', {
						page: root.dataset.pageId ?? window.location.pathname,
						section: root.dataset.sectionId ?? 'faq',
					});
				}
			});
		}

		root.querySelectorAll<HTMLDetailsElement>('[data-faq-question]').forEach((item) => {
			item.addEventListener('toggle', () => {
				if (!item.open) return;
				analytics('faq_question_open', { question_id: item.dataset.questionId ?? 'faq-question' });
			});
		});
	});
</script>

<style>
	.global-faq {
		--faq-ink: var(--proto-ink, var(--pc-ink, #1d211e));
		--faq-muted: var(--proto-muted, var(--pc-muted, #656963));
		--faq-accent: var(--proto-accent, var(--pc-gold, #986536));
		--faq-border: var(--proto-border, var(--pc-border, rgba(29, 33, 30, 0.14)));
		position: relative;
		isolation: isolate;
		width: min(72rem, 100%);
		margin-inline: auto;
		color: var(--faq-ink);
	}

	.global-faq__watermark {
		position: absolute;
		top: -0.08em;
		left: -0.04em;
		z-index: -1;
		pointer-events: none;
		color: color-mix(in srgb, var(--faq-accent) 9%, transparent);
		font-family: var(--font-source-serif-4), Georgia, serif;
		font-size: clamp(10rem, 24vw, 23rem);
		font-weight: 600;
		line-height: 0.72;
		letter-spacing: -0.08em;
	}

	.global-faq__head {
		max-width: 54rem;
		margin-bottom: clamp(1.75rem, 4vw, 3rem);
	}

	.global-faq__eyebrow {
		margin: 0 0 0.75rem;
		color: var(--faq-accent);
		font-family: var(--font-inter), Inter, system-ui, sans-serif;
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.16em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.global-faq h2 {
		margin: 0;
		font-family: var(--font-source-serif-4), Georgia, serif;
		font-size: clamp(2.7rem, 5.2vw, 5rem);
		font-weight: 500;
		line-height: 0.98;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	.global-faq__intro {
		max-width: 48rem;
		margin: 1rem 0 0;
		color: var(--faq-muted);
		font-size: clamp(0.96rem, 1.3vw, 1.12rem);
		line-height: 1.65;
	}

	.global-faq__list {
		display: grid;
		gap: 1px;
		border: 1px solid var(--faq-border);
		background: var(--faq-border);
	}

	.global-faq__list--extra {
		margin-top: 1px;
	}

	.global-faq[data-enhanced='true'][data-expanded='false'] .global-faq__list--extra {
		display: none;
	}

	.global-faq__item {
		background: rgba(255, 255, 255, 0.76);
	}

	.global-faq summary {
		position: relative;
		padding: clamp(1.1rem, 2vw, 1.55rem) clamp(3.3rem, 5vw, 4.5rem) clamp(1.1rem, 2vw, 1.55rem) clamp(1.1rem, 2vw, 1.55rem);
		font-family: var(--font-source-serif-4), Georgia, serif;
		font-size: clamp(1.3rem, 2vw, 1.85rem);
		font-weight: 500;
		line-height: 1.18;
		cursor: pointer;
		list-style: none;
	}

	.global-faq summary::-webkit-details-marker {
		display: none;
	}

	.global-faq summary::after {
		content: '+';
		position: absolute;
		top: 50%;
		right: clamp(1.1rem, 2vw, 1.55rem);
		color: var(--faq-accent);
		font-family: var(--font-inter), Inter, system-ui, sans-serif;
		font-size: 1.35rem;
		font-weight: 500;
		transform: translateY(-50%);
	}

	.global-faq details[open] summary::after {
		content: '−';
	}

	.global-faq summary:focus-visible,
	.global-faq__action button:focus-visible,
	.global-faq__links a:focus-visible {
		outline: 3px solid color-mix(in srgb, var(--faq-accent) 72%, white);
		outline-offset: 3px;
	}

	.global-faq__answer {
		max-width: 56rem;
		padding: 0 clamp(1.1rem, 2vw, 1.55rem) clamp(1.25rem, 2.4vw, 1.8rem);
		color: var(--faq-muted);
		font-size: 0.96rem;
		line-height: 1.7;
	}

	.global-faq__answer :global(p) {
		margin: 0;
	}

	.global-faq__answer :global(p + p) {
		margin-top: 0.75rem;
	}

	.global-faq__answer :global(a),
	.global-faq__links a {
		color: var(--faq-accent);
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.global-faq__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		margin-top: 0.8rem !important;
	}

	.global-faq__action {
		display: flex;
		justify-content: center;
		padding: 1.25rem 0;
	}

	.global-faq__action button {
		min-height: 46px;
		padding: 0.75rem 1.1rem;
		border: 1px solid var(--faq-ink);
		border-radius: 999px;
		background: transparent;
		color: var(--faq-ink);
		font: 700 0.84rem/1.2 var(--font-inter), Inter, system-ui, sans-serif;
		cursor: pointer;
	}

	.global-faq__action button:hover {
		background: var(--faq-ink);
		color: #fff;
	}

	@media (max-width: 600px) {
		.global-faq__watermark {
			top: -0.02em;
			left: -0.05em;
			font-size: 43vw;
		}

		.global-faq__head {
			margin-bottom: 1.5rem;
		}

		.global-faq h2 {
			font-size: clamp(2.35rem, 11.3vw, 3.25rem);
		}

		.global-faq summary {
			padding: 1rem 3rem 1rem 1rem;
			font-size: 1.08rem;
			line-height: 1.3;
		}

		.global-faq summary::after {
			right: 1rem;
		}

		.global-faq__answer {
			padding: 0 1rem 1.15rem;
			font-size: 0.9rem;
			line-height: 1.62;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.global-faq__action button {
			transition: none;
		}
	}
</style>
