---
import { Picture, getImage } from 'astro:assets';
import { render } from 'astro:content';
import PrototypeHeader from '@/components/prototype/PrototypeHeader.astro';
import PrototypeLayout from '@/layouts/PrototypeLayout.astro';
import Footer from '@/sections/Footer.astro';
import type { BlogPost } from '@/data/blog';
import BlogBreadcrumb from './BlogBreadcrumb.astro';
import BlogConnections from './BlogConnections.astro';
import CaseStudyBeforeAfter from './CaseStudyBeforeAfter.astro';
import CaseStudyGallery from './CaseStudyGallery.astro';
import CaseStudyVideo from './CaseStudyVideo.astro';
import ProjectFactsGrid from './ProjectFactsGrid.astro';
import ProjectGallery from './ProjectGallery.astro';
interface Props {
	post: BlogPost;
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const isGuide = d.type === 'guide';
const breadcrumbLabel = isGuide ? 'Renovation Guides' : 'Project Stories';
const canonicalPath = `/blog/${d.slug}`;
const canonicalUrl = `https://strataline.ca${canonicalPath}`;
const optimizedHero = await getImage({
	src: d.heroImage,
	width: 1600,
	format: 'webp',
	quality: 86,
});
const socialImagePath = d.socialImage ?? optimizedHero.src;
const imageUrl = `https://strataline.ca${socialImagePath}`;
const headline = d.heroHeading ?? d.title;
const publishedIso = d.publishedDate.toISOString();
const modifiedIso = (d.updatedDate ?? d.publishedDate).toISOString();
const primaryImageId = `${canonicalUrl}#primaryimage`;
const schemas = [
	{
		'@type': d.schemaType,
		'@id': `${canonicalUrl}#article`,
		headline,
		description: d.description,
		url: canonicalUrl,
		mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
		image: { '@id': primaryImageId },
		primaryImageOfPage: { '@id': primaryImageId },
		datePublished: publishedIso,
		dateModified: modifiedIso,
		articleSection: d.category,
		author: {
			'@type': 'Person',
			'@id': 'https://strataline.ca/#maxim-sologub',
			name: d.author,
			jobTitle: 'Owner',
		},
		publisher: { '@id': 'https://strataline.ca/#business' },
		isPartOf: { '@id': 'https://strataline.ca/#website' },
		about: [d.service, d.location].filter(Boolean),
		breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
	},
	{
		'@type': 'BreadcrumbList',
		'@id': `${canonicalUrl}#breadcrumb`,
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://strataline.ca/' },
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Guides',
				item: 'https://strataline.ca/blog',
			},
			{ '@type': 'ListItem', position: 3, name: breadcrumbLabel, item: canonicalUrl },
		],
	},
	{
		'@type': 'ImageObject',
		'@id': primaryImageId,
		url: imageUrl,
		contentUrl: imageUrl,
		caption: d.heroAlt,
	},
];
const compare = d.beforeAfter;
const hasContentBlocks = d.contentBlocks.length > 0;
const hasStructuredStory = d.storySections.length > 0;
const relatedStoryBlocks = d.contentBlocks.filter((block) => block.type === 'related-stories');
const isDocumentHero = d.heroPresentation === 'document';
const comparisons = new Map(d.comparisons.map((item) => [item.id, item]));
const cta = d.cta ?? {
	heading: 'Have a similar project?',
	text: 'Send us details and we’ll help determine the right approach.',
	primaryLabel: 'Request a Quote',
	formProjectType: undefined,
};
---

<PrototypeLayout
	title={d.seoTitle ?? d.title}
	description={d.description}
	image={socialImagePath}
	{canonicalPath}
	{schemas}
	ogType="article"
	articleMeta={{ publishedTime: publishedIso, modifiedTime: modifiedIso, author: d.author }}
	robots="index,follow,max-image-preview:large"
>
	<div class="blog-page case-study-page">
		<PrototypeHeader />
		<main>
			<article class="case-study">
				<header
					class:list={['case-hero', 'case-media--hero', { 'case-hero--document': isDocumentHero }]}
				>
					{
						!isDocumentHero && (
							<Picture
								src={d.heroImage}
								alt={d.heroAlt}
								widths={[720, 1080, 1440, 1920]}
								sizes="100vw"
								formats={['avif', 'webp']}
								loading="eager"
								fetchpriority="high"
							/>
						)
					}
					<div class="case-hero__shade" aria-hidden="true"></div>
					<div class:list={['case-hero__composition', { 'blog-shell': isDocumentHero }]}>
						<div class:list={['case-hero__content', { 'blog-shell': !isDocumentHero }]}>
							<BlogBreadcrumb current={breadcrumbLabel} />
							<p class="blog-eyebrow">
								{
									d.heroEyebrow ??
										`${isGuide ? 'RENOVATION GUIDE' : 'PROJECT STORY'} · ${d.category}`
								}
							</p>
							<h1>{d.heroHeading ?? d.title}</h1>
							<p>{d.heroIntro ?? d.description}</p>
							<div class="case-hero__meta">
								{d.location && <span>{d.location}</span>}{d.service && <span>{d.service}</span>}
							</div>
						</div>
						{
							isDocumentHero && (
								<div class="case-hero__document-column">
									<div class="case-hero__document-label">
										<strong>THE TORONTO STAR · AUGUST 26, 2017</strong>
										<span>FROM THE STRATALINE ARCHIVE</span>
									</div>
									<div class="case-hero__document-media">
										<CaseStudyGallery
											items={[{ image: d.heroImage, alt: d.heroAlt, caption: d.heroActionLabel }]}
											idPrefix={`hero-${d.slug}`}
											viewMode="document"
											actionLabel={d.heroActionLabel ?? 'View full image →'}
										/>
									</div>
								</div>
							)
						}
					</div>
				</header>
				<div class="blog-shell case-study__body">
					{d.projectFacts.length > 0 && <ProjectFactsGrid post={post} />}
					{
						hasContentBlocks ? (
							d.contentBlocks.map((block, index) => {
								if (block.type === 'text-media')
									return (
										<section
											class:list={[
												'case-section case-text-media',
												`case-text-media--${block.media.size}`,
												{ 'case-story-section--opening': index === 0 },
											]}
										>
											<div class="case-text-media__header">
												<p class="blog-eyebrow">{block.eyebrow ?? 'In this project'}</p>
												<h2>{block.heading}</h2>
												<div class="case-story-section__copy">
													{block.paragraphs.map((paragraph) =>
														typeof paragraph === 'string' ? (
															<p>{paragraph}</p>
														) : (
															<p>
																{paragraph.before}
																<a href={paragraph.href}>{paragraph.label}</a>
																{paragraph.after}
															</p>
														),
													)}
												</div>
												{block.listItems.length > 0 && (
													<div class="case-story-list">
														{block.listHeading && <h3>{block.listHeading}</h3>}
														<ul>
															{block.listItems.map((item) => (
																<li>{item}</li>
															))}
														</ul>
													</div>
												)}
											</div>
											<div
												class:list={[
													'case-text-media__media case-media',
													`case-media--${block.media.size}`,
												]}
											>
												{block.media.type === 'image' && (
													<CaseStudyGallery
														items={[
															{
																image: block.media.image,
																alt: block.media.alt,
																caption: block.media.caption,
															},
														]}
														idPrefix={`content-${d.slug}-${index}`}
														viewMode={
															block.media.presentation === 'document' ? 'document' : 'standard'
														}
														layout="editorial"
													/>
												)}
												{block.media.type === 'image-pair' && (
													<CaseStudyGallery
														items={block.media.items}
														idPrefix={`content-${d.slug}-${index}`}
														layout="editorial"
														matched={Boolean(block.media.pairContext && block.media.pairNumber)}
													/>
												)}
												{block.media.type === 'before-after' && (
													<CaseStudyBeforeAfter
														beforeImage={block.media.beforeImage}
														beforeAlt={block.media.beforeAlt}
														afterImage={block.media.afterImage}
														afterAlt={block.media.afterAlt}
														caption={block.media.caption}
													/>
												)}
												{block.media.type === 'gallery' && (
													<CaseStudyGallery
														items={block.media.items}
														idPrefix={`content-${d.slug}-${index}`}
														layout={block.media.layout === 'project' ? 'project' : 'editorial'}
													/>
												)}
											</div>
										</section>
									);
								if (block.type === 'text')
									return (
										<section
											class:list={[
												'case-section case-story-section',
												{ 'case-story-section--opening': index === 0 },
											]}
										>
											{d.mediaBadge && block.heading === d.mediaBadge.sectionHeading && (
												<aside class="case-media-badge" aria-label={d.mediaBadge.label}>
													<p>{d.mediaBadge.label}</p>
													<Picture
														src={d.mediaBadge.image}
														alt={d.mediaBadge.alt}
														widths={[300, 600]}
														sizes="(max-width: 700px) 72vw, 380px"
														formats={['avif', 'webp']}
														loading="lazy"
													/>
													{d.mediaBadge.archiveLabel && <span>{d.mediaBadge.archiveLabel}</span>}
												</aside>
											)}
											<p class="blog-eyebrow">{block.eyebrow ?? 'In this project'}</p>
											<h2>{block.heading}</h2>
											<div class="case-story-section__copy">
												{block.paragraphs.map((paragraph) =>
													typeof paragraph === 'string' ? (
														<p>{paragraph}</p>
													) : (
														<p>
															{paragraph.before}
															<a href={paragraph.href}>{paragraph.label}</a>
															{paragraph.after}
														</p>
													),
												)}
											</div>
											{block.listItems.length > 0 && (
												<div class="case-story-list">
													{block.listHeading && <h3>{block.listHeading}</h3>}
													<ul>
														{block.listItems.map((item) => (
															<li>{item}</li>
														))}
													</ul>
												</div>
											)}
										</section>
									);
								if (block.type === 'image')
									return (
										<section
											class:list={[
												'case-section case-inline-media case-media',
												`case-media--${block.size ?? block.layout}`,
												{ 'case-inline-media--detail': block.layout === 'detail' },
												{ 'case-inline-media--document': block.presentation === 'document' },
											]}
										>
											<CaseStudyGallery
												items={[{ image: block.image, alt: block.alt, caption: block.caption }]}
												idPrefix={'content-' + d.slug + '-' + index}
												viewMode={block.presentation === 'document' ? 'document' : 'standard'}
												actionLabel={block.actionLabel}
											/>
										</section>
									);
								if (block.type === 'image-pair')
									return (
										<section
											class:list={[
												'case-section case-inline-media case-inline-media--pair case-media',
												`case-media--${block.size ?? 'pair'}`,
												{
													'case-inline-media--portrait-pair': block.items.every(
														(item) => item.image.height > item.image.width,
													),
												},
											]}
										>
											{block.heading && <h2>{block.heading}</h2>}
											<div class="case-image-pair">
												<CaseStudyGallery
													items={block.items}
													idPrefix={'content-' + d.slug + '-' + index}
												/>
												{block.caption && <p class="case-image-pair__caption">{block.caption}</p>}
											</div>
										</section>
									);
								if (block.type === 'gallery')
									return (
										<section
											class:list={[
												'case-section case-inline-media case-media',
												`case-media--${block.size ?? (block.purpose === 'finished-project' ? 'gallery' : 'wide')}`,
											]}
										>
											{block.purpose === 'finished-project' ? (
												<ProjectGallery
													items={block.items}
													idPrefix={'content-' + d.slug + '-' + index}
													eyebrow={block.eyebrow}
													heading={block.heading}
												/>
											) : (
												<>
													{block.eyebrow && <p class="blog-eyebrow">{block.eyebrow}</p>}
													{block.heading && <h2>{block.heading}</h2>}
													<CaseStudyGallery
														items={block.items}
														idPrefix={'content-' + d.slug + '-' + index}
														layout="editorial"
													/>
												</>
											)}
										</section>
									);
								if (block.type === 'video')
									return (
										<section class="case-section case-inline-media">
											{block.heading && <h2>{block.heading}</h2>}
											<CaseStudyVideo
												source={block.source}
												poster={block.poster}
												caption={block.caption}
												preload={block.preload}
											/>
										</section>
									);
								if (block.type === 'related-stories') return null;
								if (block.type === 'related-story')
									return (
										<section
											class:list={[
												'case-section case-related-story',
												`case-related-story--${block.imageFit}`,
											]}
										>
											<a href={block.href}>
												<div class="case-related-story__media">
													<Picture
														src={block.image}
														alt={block.alt}
														widths={[320, 560, 760]}
														sizes="(max-width: 700px) 100vw, 320px"
														formats={['avif', 'webp']}
														loading="lazy"
													/>
												</div>
												<div class="case-related-story__copy">
													<p>{block.eyebrow}</p>
													<h2>{block.title}</h2>
													<span>{block.context}</span>
													<strong>{block.linkLabel}</strong>
												</div>
											</a>
										</section>
									);
								if (block.type === 'before-after')
									return (
										<section
											class:list={[
												'case-section case-inline-media case-media',
												`case-media--${block.size ?? 'slider'}`,
											]}
										>
											{block.heading && <h2>{block.heading}</h2>}
											<CaseStudyBeforeAfter
												beforeImage={block.beforeImage}
												beforeAlt={block.beforeAlt}
												afterImage={block.afterImage}
												afterAlt={block.afterAlt}
												caption={block.caption}
											/>
										</section>
									);
							})
						) : hasStructuredStory ? (
							d.storySections.map((section, index) => {
								const sectionComparison = section.comparisonId
									? comparisons.get(section.comparisonId)
									: undefined;
								return (
									<section
										class:list={[
											'case-section case-story-section',
											{ 'case-story-section--opening': index === 0 },
										]}
									>
										<p class="blog-eyebrow">{section.eyebrow ?? 'In this project'}</p>
										<h2>{section.heading}</h2>
										<div class="case-story-section__copy">
											{section.paragraphs.map((paragraph) =>
												typeof paragraph === 'string' ? (
													<p>{paragraph}</p>
												) : (
													<p>
														{paragraph.before}
														<a href={paragraph.href}>{paragraph.label}</a>
														{paragraph.after}
													</p>
												),
											)}
										</div>
										{section.listItems.length > 0 && (
											<div class="case-story-list">
												{section.listHeading && <h3>{section.listHeading}</h3>}
												<ul>
													{section.listItems.map((item) => (
														<li>{item}</li>
													))}
												</ul>
											</div>
										)}
										{section.image && (
											<figure class="case-process-image">
												<Picture
													src={section.image}
													alt={section.imageAlt ?? ''}
													widths={[640, 960, 1280, 1600]}
													sizes="(max-width: 767px) 94vw, 76vw"
													formats={['avif', 'webp']}
													loading="lazy"
												/>
												{section.imageCaption && <figcaption>{section.imageCaption}</figcaption>}
											</figure>
										)}
										{section.gallery.length > 0 && (
											<CaseStudyGallery
												items={section.gallery}
												idPrefix={'gallery-' + d.slug + '-' + index}
											/>
										)}
										{sectionComparison && (
											<CaseStudyBeforeAfter
												beforeImage={sectionComparison.beforeImage}
												beforeAlt={sectionComparison.beforeAlt}
												afterImage={sectionComparison.afterImage}
												afterAlt={sectionComparison.afterAlt}
												caption={sectionComparison.caption}
											/>
										)}
									</section>
								);
							})
						) : (
							<>
								<section class="case-section case-challenge">
									<h2>What the project needed</h2>
									{d.challenge && <p class="case-lead">{d.challenge}</p>}
									{d.solution && <p>{d.solution}</p>}
								</section>
								{compare?.beforeImage && compare.afterImage && (
									<section class="case-section case-transformation">
										<p class="blog-eyebrow">The transformation</p>
										<h2>Before and after</h2>
										<CaseStudyBeforeAfter
											beforeImage={compare.beforeImage}
											beforeAlt={compare.beforeAlt ?? 'Before renovation'}
											afterImage={compare.afterImage}
											afterAlt={compare.afterAlt ?? 'After renovation'}
											caption={compare.caption}
										/>
									</section>
								)}
								{d.scope.length > 0 && (
									<section class="case-section case-scope">
										<p class="blog-eyebrow">Work completed</p>
										<h2>Scope of work</h2>
										<ul>
											{d.scope.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									</section>
								)}
								<section class="case-section">
									<>
										<p class="blog-eyebrow">The process</p>
										<h2>Why the work required expertise</h2>
										<div class="blog-prose">
											<Content />
										</div>
									</>
								</section>
								{d.video?.enabled !== false && d.video && (
									<section class="case-section">
										<p class="blog-eyebrow">On site</p>
										<h2>See the work in progress</h2>
										<CaseStudyVideo
											source={d.video.source}
											poster={d.video.poster}
											caption={d.video.caption}
										/>
									</section>
								)}
								<section class="case-section case-result">
									<h2>The outcome</h2>
									{d.result && <p class="case-lead">{d.result}</p>}
								</section>
							</>
						)
					}
					{
						d.gallery.length > 0 && (
							<section class="case-section case-media case-media--gallery">
								<ProjectGallery
									items={d.gallery}
									idPrefix={`gallery-${d.slug}`}
									eyebrow="FINISHED PROJECT"
									heading="Complete project gallery"
								/>
							</section>
						)
					}
					{
						d.homeownerInsights.length > 0 && (
							<section class="case-section case-scope">
								<>
									<p class="blog-eyebrow">Planning value</p>
									<h2>What this project shows homeowners</h2>
									<ul>
										{d.homeownerInsights.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								</>
							</section>
						)
					}
					{
						d.homeownerQuestions.length > 0 && (
							<section class="case-section case-homeowner-questions">
								<>
									<p class="blog-eyebrow">Planning answers</p>
									<h2>What homeowners can learn from this project</h2>
									<div>
										{d.homeownerQuestions.map((item) => (
											<article>
												<h3>{item.question}</h3>
												<p>{item.answer}</p>
											</article>
										))}
									</div>
								</>
							</section>
						)
					}
					{
						d.review?.enabled !== false && d.review?.quote && d.review.reviewer && (
							<section class="case-section case-review">
								<>
									<blockquote>“{d.review.quote}”</blockquote>
									<p>— {d.review.reviewer}</p>
								</>
							</section>
						)
					}
					<section class="case-section case-related">
						<p class="blog-eyebrow">Related services</p><h2>Related project services</h2><div>
							{
								d.relatedServices.map((service) => (
									<a href={service.href}>
										{service.label}
										<span aria-hidden="true">→</span>
									</a>
								))
							}
						</div>
					</section>
					{
						relatedStoryBlocks.map((block) => (
							<section class="case-section case-related-projects">
								<p class="blog-eyebrow">{block.eyebrow}</p>
								<h2>{block.heading}</h2>
								<div class="case-related-projects__grid">
									{block.items.map((item) => (
										<a href={item.href} class="case-related-project-card">
											<Picture
												src={item.image}
												alt={item.alt}
												widths={[320, 520, 720]}
												sizes="(max-width: 700px) 94vw, 360px"
												formats={['avif', 'webp']}
												loading="lazy"
											/>
											<div>
												<p>{item.location}</p>
												<h3>{item.title}</h3>
												<span>{item.context}</span>
												<strong>{item.linkLabel}</strong>
											</div>
										</a>
									))}
								</div>
							</section>
						))
					}
					<BlogConnections post={post} />
					<aside class="case-author">
						<p><strong>{d.author}</strong><br />Owner, Strataline Inc.</p><p>
							Based on real Strataline renovation projects completed across Toronto and the GTA.
						</p>
					</aside>
					<section class="case-cta">
						<h2>{cta.heading}</h2><p>{cta.text}</p><div>
							<button
								type="button"
								data-blog-contact="case-study"
								data-form-project-type={cta.formProjectType}>{cta.primaryLabel}</button
							><a href="tel:+14164715999">Call or Text (416) 471-5999</a>
