---
import type { ImageMetadata } from 'astro';
import BeforeAfterViewer from '@/components/prototype/BeforeAfterViewer.astro';
import CaseStudyGallery from '@/components/blog/CaseStudyGallery.astro';

interface Props {
	beforeImage: ImageMetadata;
	afterImage: ImageMetadata;
	beforeAlt: string;
	afterAlt: string;
	caption?: string;
}

const { beforeImage, afterImage, beforeAlt, afterAlt, caption } = Astro.props;
const beforeAspectRatio = beforeImage.width / beforeImage.height;
const afterAspectRatio = afterImage.width / afterImage.height;
const isWideComparison = afterAspectRatio >= 1.75;
const isPortraitComparison =
	beforeImage.height > beforeImage.width && afterImage.height > afterImage.width;
const isMatchedAspectComparison =
	!isPortraitComparison && Math.abs(beforeAspectRatio - afterAspectRatio) < 0.03;
const usesNaturalAspectRatio = isMatchedAspectComparison;
const comparisonId = `case-study-comparison-${beforeImage.src
	.split('/')
	.at(-1)
	?.replace(/[^a-z0-9]+/gi, '-')
	.replace(/^-|-$/g, '')}`;
---

<figure
	class:list={[
		'case-comparison',
		isWideComparison && 'case-comparison--wide',
		isPortraitComparison && 'case-comparison--portrait',
		isMatchedAspectComparison && 'case-comparison--matched-aspect',
	]}
	style={usesNaturalAspectRatio
		? `--case-comparison-aspect-ratio: ${afterImage.width} / ${afterImage.height}`
		: undefined}
>
	<BeforeAfterViewer
		comparison={{
			id: comparisonId,
			title: caption ?? 'Project before and after comparison',
			beforeImage,
			afterImage,
			beforeAlt,
			afterAlt,
			beforeObjectPosition: 'center center',
			afterObjectPosition: 'center center',
		}}
		eventName="case_study_before_after_interaction"
		viewerId={comparisonId}
	/>
	{caption && <figcaption>{caption}</figcaption>}
	<CaseStudyGallery
		items={[
			{ image: beforeImage, alt: beforeAlt },
			{ image: afterImage, alt: afterAlt },
		]}
		idPrefix={`${comparisonId}-originals`}
		display="original-links"
	/>
</figure>
