---
import type { ImageMetadata } from 'astro';
import BeforeAfterViewer from '@/components/prototype/BeforeAfterViewer.astro';

interface Props {
	beforeImage: ImageMetadata;
	afterImage: ImageMetadata;
	beforeAlt: string;
	afterAlt: string;
	caption?: string;
}

const { beforeImage, afterImage, beforeAlt, afterAlt, caption } = Astro.props;
const isWideComparison = afterImage.width / afterImage.height >= 1.75;
const isPortraitComparison =
	beforeImage.height > beforeImage.width && afterImage.height > afterImage.width;
---

<figure
	class:list={[
		'case-comparison',
		isWideComparison && 'case-comparison--wide',
		isPortraitComparison && 'case-comparison--portrait',
	]}
	style={isPortraitComparison ? `--case-comparison-aspect-ratio: ${afterImage.width} / ${afterImage.height}` : undefined}
>
	<BeforeAfterViewer
		comparison={{
			id: 'case-study-comparison',
			title: caption ?? 'Project before and after comparison',
			beforeImage,
			afterImage,
			beforeAlt,
			afterAlt,
			beforeObjectPosition: 'center center',
			afterObjectPosition: 'center center',
		}}
		eventName="case_study_before_after_interaction"
	/>
	{caption && <figcaption>{caption}</figcaption>}
</figure>