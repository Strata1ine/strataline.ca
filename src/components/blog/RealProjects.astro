---
import { Picture } from 'astro:assets';
import { getPublishedBlogPosts } from '@/data/blog';
import { getServiceProjects } from '@/data/projectsGuides';

interface Props {
	serviceHref: string;
	heading?: string;
	description?: string;
	limit?: number;
}
const {
	serviceHref,
	heading = 'Real projects connected to this service.',
	description = 'Explore completed Strataline work with project conditions, decisions and finished results.',
	limit = 6,
} = Astro.props;
const posts = await getPublishedBlogPosts();
const projects = getServiceProjects(posts, serviceHref).slice(0, Math.max(4, Math.min(limit, 8)));
---

{
	projects.length > 0 && (
		<section
			class="real-projects"
			aria-labelledby={`real-projects-${serviceHref.replace(/[^a-z]+/g, '-')}`}
		>
			<div class="real-projects__inner">
				<header>
					<p>REAL PROJECTS</p>
					<h2 id={`real-projects-${serviceHref.replace(/[^a-z]+/g, '-')}`}>{heading}</h2>
					<span>{description}</span>
				</header>
				<div class="real-projects__grid">
					{projects.map((post) => (
						<article>
							<a href={`/blog/${post.data.slug}`}>
								<Picture
									src={post.data.heroImage}
									alt={post.data.heroAlt}
									widths={[360, 560, 760]}
									sizes="(max-width: 700px) 92vw, 28vw"
									formats={['avif', 'webp']}
									loading="lazy"
								/>
								<strong>{post.data.title}</strong>
							</a>
							<a href={serviceHref}>
								Explore the service <span aria-hidden="true">→</span>
							</a>
						</article>
					))}
				</div>
				<a class="real-projects__all" href="/blog">
					Explore all Projects &amp; Guides <span aria-hidden="true">→</span>
				</a>
			</div>
		</section>
	)
}

<style>
	.real-projects {
		padding: clamp(4rem, 8vw, 7rem) 1.25rem;
		background: #f4f1e9;
		color: #17201b;
	}
	.real-projects__inner {
		width: min(1180px, 100%);
		margin-inline: auto;
	}
	.real-projects header {
		max-width: 780px;
		margin-bottom: 2rem;
	}
	.real-projects header > p {
		margin: 0 0 0.65rem;
		color: #a6672e;
		font: 600 0.78rem/1.2 var(--font-inter);
		letter-spacing: 0.16em;
	}
	.real-projects h2 {
		margin: 0 0 0.65rem;
		font: 500 clamp(2rem, 4vw, 3.6rem)/1 var(--font-source-serif-4);
	}
	.real-projects header > span {
		color: #4d5751;
		line-height: 1.65;
	}
	.real-projects__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
		gap: 1.25rem;
	}
	.real-projects article {
		display: grid;
		align-content: start;
		background: #fff;
		border-radius: 14px;
		overflow: hidden;
		box-shadow: 0 12px 30px rgba(17, 31, 23, 0.08);
	}
	.real-projects article > a:first-child {
		display: grid;
		color: inherit;
		text-decoration: none;
	}
	.real-projects picture,
	.real-projects img {
		display: block;
		width: 100%;
	}
	.real-projects img {
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}
	.real-projects article strong {
		padding: 1rem 1rem 0.75rem;
		font: 500 1.25rem/1.15 var(--font-source-serif-4);
	}
	.real-projects article > a:last-child {
		padding: 0 1rem 1rem;
		color: #8b572a;
		font: 600 0.8rem/1.2 var(--font-inter);
		text-decoration: none;
	}
	.real-projects__all {
		display: inline-block;
		margin-top: 1.5rem;
		color: #17201b;
		font-weight: 600;
	}
</style>
