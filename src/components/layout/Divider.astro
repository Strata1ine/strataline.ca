---
import { cn } from '@/frontend/utils';

interface Props {
	id?: string;
	as?: 'section' | 'footer' | 'main';
	class?: string;
}
const { id, class: className, as: Tag = 'section' }: Props = Astro.props;

const isHomepage = Astro.url.pathname === '/';
const homepageSpacingById: Record<string, string> = {
	trust: 'mt-10 md:mt-16',
	media: 'mt-12 md:mt-20',
	explore: 'mt-12 md:mt-20',
	'interior-renovations': 'mt-16 md:mt-24',
	'stairs-feature': 'mt-10 md:mt-16',
	'owner-led': 'mt-10 md:mt-16',
	reviews: 'mt-10 md:mt-16',
	'service-area': 'mt-12 md:mt-20',
	contact: 'mt-12 md:mt-20',
};

const homepageSpacing =
	(id ? homepageSpacingById[id] : undefined) ??
	(Tag === 'footer' ? 'mt-10 md:mt-16' : 'mt-12 md:mt-20');
const spacing = isHomepage ? homepageSpacing : 'mt-30 md:mt-38';
---

<Tag class={cn(spacing, className)} {id}>
	<slot />
</Tag>
