---
import GlobalHeader from '@/components/GlobalHeader.astro';

import { type SchemaOf, createSchema } from 'astro-frontmatter-cms';
import { type SchemaContext } from 'astro:content';
import { z } from 'astro:schema';

export const schema = createSchema('Header', (_: SchemaContext) =>
	z.object({
		content: z.array(
			z.object({ id: z.string().optional(), href: z.string().optional(), name: z.string() }),
		),
	}),
);

export type Props = SchemaOf<typeof schema>;
---

<GlobalHeader />
