---
import { type SchemaOf, createSchema } from 'astro-frontmatter-cms';
import { type SchemaContext } from 'astro:content';
import { z } from 'astro:schema';
import { DefaultPos } from '@/schemas';

export const schema = createSchema('Benefits', (_: SchemaContext) =>
	z.object({
		id: z.string().optional(),
		pos: DefaultPos,
		title: z.string(),
		content: z.array(
			z.object({
				title: z.string(),
				desc: z.string(),
			}),
		),
	}),
);

export type Props = SchemaOf<typeof schema>;
const meta = Astro.props as Props;
const isHomepageTrust = Astro.url.pathname === '/' && meta.id === 'trust';

import * as Layout from '@/components/Layout';
import markdown from '@/build/markdown';
---

<Layout.Divider id={meta.id}>
	<Layout.Title title={meta.title} pos={meta.pos} class="relative flex items-center gap-6" />

	<Layout.Container variant="inner">
		<div
			class:list={[
				'grid gap-4 sm:grid-cols-2 md:gap-5 xl:gap-6',
				isHomepageTrust ? 'grid-cols-2 gap-3' : 'grid-cols-1',
			]}
		>
			{
				meta.content.map(async (benefit) => {
					return (
						<article
							class:list={[
								'rounded-lg border border-black/10 bg-white/70 shadow-sm shadow-black/5 md:p-6',
								isHomepageTrust ? 'p-3 min-[380px]:p-4 sm:p-5' : 'p-5',
							]}
						>
							<h3
								class:list={[
									'font-serif leading-tight font-semibold text-pretty md:text-3xl',
									isHomepageTrust ? 'text-lg min-[380px]:text-xl sm:text-2xl' : 'text-2xl',
								]}
							>
								{benefit.title}
							</h3>

							<p
								class:list={[
									'font-sans text-black/75 md:text-lg md:leading-9',
									isHomepageTrust
										? 'mt-2 text-sm leading-relaxed sm:mt-3 sm:text-base sm:leading-8'
										: 'mt-3 text-base leading-8',
								]}
								set:html={await markdown.parseInline(benefit.desc)}
							/>
						</article>
					);
				})
			}
		</div>
	</Layout.Container>
</Layout.Divider>
