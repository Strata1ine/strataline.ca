---
import { type SchemaOf, createSchema } from 'astro-frontmatter-cms';
import { type SchemaContext } from 'astro:content';
import { z } from 'astro:schema';
import { DefaultPos } from '@/schemas';
import business from '#/business.json';

export const schema = createSchema('Faq', (_: SchemaContext) => z.object({
	id: z.string().optional(),
	pos: DefaultPos,
	title: z.string(),
	showMoreLabel: z.string().optional(),
	content: z.array(
		z.object({
			title: z.string(),
			desc: z.string(),
		}),
	),
}));

export const seo = async (Astro: Astro, faqs: Props[]) => {
	return {
		'@type': 'FAQPage',
		mainEntity: await Promise.all(
			faqs.flatMap((faq) =>
				faq.content.map(async (content) => ({
					'@type': 'Question',
					name: content.title,
					acceptedAnswer: {
						'@type': 'Answer',
						text: await markdown.parse(content.desc),
					},
				})),
			),
		),
		provider: {
			'@type': business['@type'],
			'@id': `${Astro.url.origin}#company`,
		},
	};
};

export type Props = SchemaOf<typeof schema>;
const meta = Astro.props as Props;

import markdown from '@/build/markdown';
for (const faq of meta.content) {
	faq.desc = await markdown.parse(faq.desc);
}

import * as Layout from '@/components/Layout';
import ProgressiveFaq from '@/components/ProgressiveFaq.astro';
---

<Layout.Divider id={meta.id}>
	<Layout.Container variant="inner">
		<ProgressiveFaq
			items={meta.content.map((item) => ({ question: item.title, answerHtml: item.desc }))}
			heading={meta.title}
			sectionId={meta.id ?? 'faq'}
			pageId={Astro.url.pathname}
		/>
	</Layout.Container>
</Layout.Divider>
