---
import Root from '@/layouts/Root.astro';
import ReviewCollection from '@/components/ReviewCollection.astro';
import { getReviewsByIds, getReviewsForCollection } from '@/data/reviews';

const googleReviewUrl = 'https://g.page/r/CVMFoUd4wK3bEBE/review';
const houzzUrl = 'https://www.houzz.com/writeProReview/cmd=r/n=maxim-sologub';
const facebookUrl = 'https://www.facebook.com/stratalineinc';

const featuredReviews = getReviewsByIds(['lani-selick', 'taras-burban', 'greg-baxter']);
const googleReviews = getReviewsForCollection('all');
---

<Root
	title="Strataline Reviews | Toronto & GTA Renovations"
	desc="Read genuine Strataline customer reviews for stair, ceiling, painting and interior renovation projects across Toronto and the GTA."
	appendBusinessName={false}
>
	<main class="reviews-page">
		<header class="reviews-hero">
			<div class="reviews-shell reviews-hero__inner">
				<p class="reviews-eyebrow">Google reviews</p>
				<h1>What clients say</h1>
				<p class="reviews-hero__lead">
					Real feedback from Strataline renovation projects across the GTA.
				</p>
			</div>
		</header>

		<section
			class="reviews-featured"
			aria-labelledby="featured-reviews-title"
			data-floating-contact-avoid
		>
			<div class="reviews-shell">
				<div class="reviews-section-heading">
					<p class="reviews-eyebrow">Featured reviews</p>
					<h2 id="featured-reviews-title">Homeowners on the finished result</h2>
				</div>
				<ReviewCollection
					reviews={featuredReviews}
					variant="featured"
					mobileScroll
					ariaLabel="Featured Strataline Google reviews"
				/>
				<p class="reviews-swipe-note">Swipe to see more featured reviews.</p>
			</div>
		</section>

		<section
			class="reviews-collection"
			aria-labelledby="all-reviews-title"
			data-floating-contact-avoid
		>
			<div class="reviews-shell">
				<div class="reviews-section-heading reviews-section-heading--collection">
					<p class="reviews-eyebrow">Google reviews</p>
					<h2 id="all-reviews-title">The full review collection</h2>
					<p>Filter by the kind of renovation you are planning.</p>
				</div>
				<ReviewCollection
					reviews={googleReviews}
					variant="cards"
					showFilters
					mobileScroll={false}
					ariaLabel="All Strataline Google reviews"
				/>
			</div>
		</section>

		<section class="reviews-leave" aria-labelledby="leave-review-title" data-floating-contact-avoid>
			<div class="reviews-shell reviews-leave__inner">
				<div>
					<p class="reviews-eyebrow">Leave a review</p>
					<h2 id="leave-review-title">Had a good experience?</h2>
					<p>Share your project with other homeowners.</p>
				</div>
				<nav class="reviews-leave__links" aria-label="Leave a Strataline review">
					<a href={googleReviewUrl} target="_blank" rel="noopener noreferrer">Google</a>
					<a href={facebookUrl} target="_blank" rel="noopener noreferrer">Facebook</a>
					<a href={houzzUrl} target="_blank" rel="noopener noreferrer">Houzz</a>
				</nav>
			</div>
		</section>
	</main>
</Root>

<style>
	.reviews-page {
		--reviews-ink: #1d211e;
		--reviews-muted: #646a65;
		--reviews-green: #17372b;
		--reviews-gold: #b08049;
		--reviews-warm: #f3eadb;
		background: #fbfaf7;
		color: var(--reviews-ink);
	}

	.reviews-shell {
		width: min(100% - 2rem, 84rem);
		margin-inline: auto;
	}

	.reviews-eyebrow {
		margin: 0;
		color: var(--reviews-gold);
		font-family: var(--font-sans);
		font-size: 0.76rem;
		font-weight: 750;
		letter-spacing: 0.17em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.reviews-hero {
		display: grid;
		min-height: clamp(18rem, 38vh, 25rem);
		place-items: center;
		background:
			linear-gradient(115deg, rgba(18, 51, 39, 0.96), rgba(24, 58, 45, 0.88)),
			radial-gradient(circle at 84% 22%, rgba(176, 128, 73, 0.28), transparent 34%);
		color: #fff;
	}

	.reviews-hero__inner {
		padding-block: clamp(3rem, 7vw, 5.5rem);
	}

	.reviews-hero h1,
	.reviews-section-heading h2,
	.reviews-leave h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-weight: 600;
		letter-spacing: -0.035em;
	}

	.reviews-hero h1 {
		margin-top: 0.75rem;
		font-size: clamp(3.2rem, 8vw, 6.6rem);
		line-height: 0.92;
	}

	.reviews-hero__lead {
		max-width: 39rem;
		margin: 1.15rem 0 0;
		color: rgba(255, 255, 255, 0.82);
		font-family: var(--font-sans);
		font-size: clamp(1rem, 1.6vw, 1.2rem);
		line-height: 1.55;
	}

	.reviews-featured,
	.reviews-collection,
	.reviews-leave {
		padding-block: clamp(2.5rem, 5vw, 4.5rem);
	}

	.reviews-featured {
		background: var(--reviews-warm);
	}

	.reviews-section-heading {
		max-width: 48rem;
		margin-bottom: clamp(1.35rem, 2.5vw, 2rem);
	}

	.reviews-section-heading h2,
	.reviews-leave h2 {
		margin-top: 0.55rem;
		font-size: clamp(2.15rem, 3.8vw, 3.35rem);
		line-height: 0.98;
	}

	.reviews-featured .reviews-section-heading {
		max-width: none;
	}

	.reviews-section-heading > p:last-child,
	.reviews-leave__inner > div > p:last-child {
		margin: 0.8rem 0 0;
		color: var(--reviews-muted);
		font-family: var(--font-sans);
		font-size: 1rem;
		line-height: 1.55;
	}

	.reviews-swipe-note {
		display: none;
	}

	.reviews-collection {
		background: #fbfaf7;
	}

	.reviews-section-heading--collection {
		margin-bottom: 1.25rem;
	}

	.reviews-leave {
		padding-top: 0;
		background: #fbfaf7;
	}

	.reviews-leave__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		border: 1px solid rgba(29, 33, 30, 0.14);
		border-radius: 1.25rem;
		padding: clamp(1.5rem, 4vw, 3rem);
		background: #fff;
		box-shadow: 0 1.25rem 3rem rgba(18, 27, 22, 0.07);
	}

	.reviews-leave__links {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.7rem;
	}

	.reviews-leave__links a {
		display: inline-flex;
		min-height: 46px;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--reviews-green);
		border-radius: 999px;
		padding: 0.7rem 1.15rem;
		background: var(--reviews-green);
		color: #fff;
		font-family: var(--font-sans);
		font-size: 0.88rem;
		font-weight: 750;
		text-decoration: none;
		transition:
			transform 160ms ease,
			background 160ms ease;
	}

	.reviews-leave__links a:not(:first-child) {
		background: transparent;
		color: var(--reviews-green);
	}

	.reviews-leave__links a:hover {
		transform: translateY(-2px);
	}

	.reviews-leave__links a:focus-visible {
		outline: 3px solid color-mix(in srgb, var(--reviews-gold) 72%, white);
		outline-offset: 3px;
	}

	@media (max-width: 640px) {
		.reviews-shell {
			width: min(100% - 2rem, 84rem);
		}

		.reviews-hero {
			min-height: min(42vh, 22rem);
		}

		.reviews-hero__inner {
			padding-block: 2.75rem;
		}

		.reviews-hero h1 {
			font-size: clamp(3.2rem, 15vw, 4.25rem);
		}

		.reviews-featured,
		.reviews-collection {
			padding-block: 2.5rem;
		}

		.reviews-section-heading {
			margin-bottom: 1.25rem;
		}

		.reviews-swipe-note {
			display: block;
			margin: 0.5rem 0 0;
			color: var(--reviews-muted);
			font: 650 0.76rem/1.4 var(--font-sans);
		}

		.reviews-leave {
			padding-bottom: 2.5rem;
		}

		.reviews-leave__inner {
			display: grid;
			gap: 1.25rem;
			padding: 1.35rem;
		}

		.reviews-leave__links {
			justify-content: flex-start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reviews-leave__links a {
			transition: none;
		}
	}
</style>
