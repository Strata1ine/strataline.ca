---
import BlogLibraryPage from '@/components/blog/BlogLibraryPage.astro';
import { getPublishedBlogPosts } from '@/data/blog';
import { PROJECTS_GUIDES_PAGE_SIZE } from '@/data/projectsGuides';
export const prerender = true;
export async function getStaticPaths() {
	const posts = await getPublishedBlogPosts();
	const projects = posts.filter((post) => post.data.type === 'case-study');
	const featured = projects.find((post) => post.data.featured) ?? projects[0];
	const pageCount = Math.ceil(
		posts.filter((post) => post.id !== featured?.id).length / PROJECTS_GUIDES_PAGE_SIZE,
	);
	return Array.from({ length: Math.max(0, pageCount - 1) }, (_, index) => ({
		params: { page: String(index + 2) },
		props: { page: index + 2 },
	}));
}
interface Props {
	page: number;
}
const { page } = Astro.props;
---

<BlogLibraryPage {page} />
