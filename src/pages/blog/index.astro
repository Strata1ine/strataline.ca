---
import { Picture } from 'astro:assets';
import BlogCard from '@/components/blog/BlogCard.astro';
import PrototypeHeader from '@/components/prototype/PrototypeHeader.astro';
import PrototypeLayout from '@/layouts/PrototypeLayout.astro';
import Footer from '@/sections/Footer.astro';
import { blogCategories, getPublishedBlogPosts } from '@/data/blog';
import blogHubHero from '../../../content/blog/blog-hub/blog-hero.jpg';
import '@/styles/blog.css';

export const prerender = true;

const posts = await getPublishedBlogPosts();
const projects = posts.filter((post) => post.data.type === 'case-study');
const guides = posts.filter((post) => post.data.type !== 'case-study');
const featuredProject = projects.find((post) => post.data.featured) ?? projects[0];
const latestProjects = projects.filter((post) => post.id !== featuredProject?.id);
const renderedCount = (featuredProject ? 1 : 0) + latestProjects.length + guides.length;
const title = 'Renovation Projects & Guides Toronto & GTA | Strataline';
const description =
	'Explore real Strataline renovation case studies, before-and-after projects, practical homeowner guides and planning advice from Toronto and the GTA.';
const canonicalPath = '/blog';
const canonicalUrl = `https://strataline.ca${canonicalPath}`;
const image = blogHubHero.src;
const schemas = [
	{
		'@type': 'CollectionPage',
		'@id': `${canonicalUrl}#collection`,
		url: canonicalUrl,
		name: title,
		description,
		isPartOf: { '@id': 'https://strataline.ca/#website' },
		breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
		mainEntity: {
			'@type': 'ItemList',
			itemListElement: posts.map((post, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				url: `${canonicalUrl}/${post.data.slug}`,
				name: post.data.title,
			})),
		},
	},
	{
		'@type': 'BreadcrumbList',
		'@id': `${canonicalUrl}#breadcrumb`,
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://strataline.ca/' },
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Renovation Guides & Project Stories',
				item: canonicalUrl,
			},
		],
	},
];
---

<PrototypeLayout
	{title}
	{description}
	{image}
	{canonicalPath}
	{schemas}
	robots="index,follow,max-image-preview:large"
>
	<div class="blog-page">
		<PrototypeHeader />
		<main>
			<header class="blog-index-hero blog-shell">
				<div class="blog-index-hero__media" aria-hidden="true">
					<Picture
						src={blogHubHero}
						formats={['avif', 'webp']}
						alt=""
						widths={[640, 960, 1440, 1920, 2400]}
						sizes="(max-width: 767px) 100vw, min(75rem, 100vw)"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
				<div class="blog-index-hero__shade" aria-hidden="true"></div>
				<div class="blog-index-hero__copy">
					<p class="blog-eyebrow">RENOVATION GUIDES &amp; PROJECT STORIES</p>
					<h1>Real projects. Practical answers.</h1>
					<p>
						See how Strataline solves real renovation problems—and use the lessons to plan your own
						project with confidence.
					</p>
				</div>
			</header>

			<section class="blog-library blog-shell" aria-label="Renovation projects and guides">
				{
					featuredProject && (
						<section
							class="blog-content-group blog-content-group--featured"
							data-blog-group
							aria-labelledby="featured-project-title"
						>
							<div class="blog-section-heading blog-section-heading--compact">
								<p class="blog-eyebrow">FEATURED PROJECT STORY</p>
								<h2 id="featured-project-title">The latest work, documented.</h2>
							</div>
							<div class="blog-grid blog-grid--featured">
								<BlogCard post={featuredProject} variant="featured" />
							</div>
						</section>
					)
				}

				{
					latestProjects.length > 0 && (
						<section
							class="blog-content-group"
							data-blog-group
							aria-labelledby="latest-projects-title"
						>
							<div class="blog-section-heading">
								<p class="blog-eyebrow">LATEST PROJECT STORIES</p>
								<h2 id="latest-projects-title">More transformations from Strataline projects.</h2>
							</div>
							<div class="blog-grid blog-grid--projects">
								{latestProjects.map((post) => (
									<BlogCard
										post={post}
										variant={post.data.hubProminence === 'lead' ? 'lead' : 'standard'}
									/>
								))}
							</div>
						</section>
					)
				}

				<section
					class="blog-content-group blog-content-group--guides"
					data-blog-group
					aria-labelledby="guides-title"
				>
					<div class="blog-section-heading">
						<p class="blog-eyebrow">RENOVATION GUIDES</p>
						<h2 id="guides-title">Practical guidance for planning the work.</h2>
					</div>
					<div class="blog-grid blog-grid--guides">
						{guides.map((post) => <BlogCard post={post} />)}
					</div>
				</section>

				<section class="blog-content-group blog-browse" aria-labelledby="browse-title">
					<div class="blog-section-heading blog-section-heading--compact">
						<p class="blog-eyebrow">BROWSE BY SERVICE</p>
						<h2 id="browse-title">Find the project type or guidance you need.</h2>
					</div>
					<div class="blog-filters" role="group" aria-label="Filter renovation projects and guides">
						{
							blogCategories.map((filter, index) => (
								<button
									type="button"
									class:list={{ 'is-active': index === 0 }}
									data-blog-filter={filter}
									aria-pressed={index === 0 ? 'true' : 'false'}
								>
									{filter}
								</button>
							))
						}
					</div>
					<p class="blog-results" aria-live="polite" data-blog-results>
						Showing {renderedCount}
						{renderedCount === 1 ? 'result' : 'results'}
					</p>
				</section>
			</section>

			<section
				class="blog-contact blog-shell"
				data-floating-contact-avoid
				aria-labelledby="blog-contact-title"
			>
				<div>
					<p class="blog-eyebrow">PLANNING A PROJECT?</p>
					<h2 id="blog-contact-title">Bring the questions. We’ll help clarify the scope.</h2>
					<p>Tell us what you are considering and where the project is located.</p>
				</div>
				<button class="blog-button blog-button--light" type="button" data-blog-contact
					>Request a project review</button
				>
			</section>
		</main>
		<Footer />
	</div>
</PrototypeLayout>

<script>
	const filters = Array.from(document.querySelectorAll('[data-blog-filter]'));
	const cards = Array.from(document.querySelectorAll('[data-blog-card]'));
	const results = document.querySelector('[data-blog-results]');
	filters.forEach((filter) =>
		filter.addEventListener('click', () => {
			if (!(filter instanceof HTMLButtonElement)) return;
			const value = filter.dataset.blogFilter ?? 'All';
			let visible = 0;
			filters.forEach((item) => {
				const active = item === filter;
				item.classList.toggle('is-active', active);
				item.setAttribute('aria-pressed', String(active));
			});
			cards.forEach((card) => {
				if (!(card instanceof HTMLElement)) return;
				const show =
					value === 'All' ||
					(value === 'Project Stories' && card.dataset.type === 'case-study') ||
					(value === 'Renovation Guides' && card.dataset.type !== 'case-study') ||
					card.dataset.category === value;
				card.hidden = !show;
				if (show) visible += 1;
			});
			document.querySelectorAll<HTMLElement>('[data-blog-group]').forEach((group) => {
				group.hidden = !group.querySelector('[data-blog-card]:not([hidden])');
			});
			if (results)
				results.textContent = `Showing ${visible} ${visible === 1 ? 'result' : 'results'}`;
		}),
	);
	document
		.querySelectorAll('[data-blog-contact]')
		.forEach((button) =>
			button.addEventListener('click', () =>
				document.dispatchEvent(new CustomEvent('strataline:open-contact')),
			),
		);
</script>
